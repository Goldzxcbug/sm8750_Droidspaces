--- /dev/null
+++ b/include/linux/kexec_target_trace.h
@@ -0,0 +1,54 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_KEXEC_TARGET_TRACE_H
+#define _LINUX_KEXEC_TARGET_TRACE_H
+
+#include <linux/init.h>
+#include <linux/types.h>
+
+/* Diagnostic stage IDs are part of the host decoder's versioned format. */
+enum kexec_target_trace_stage {
+	KTT_SETUP_ARCH_DONE = 1,
+	KTT_MM_CORE_BEFORE,
+	KTT_MM_CORE_AFTER,
+	KTT_INIT_IRQ_BEFORE,
+	KTT_INIT_IRQ_AFTER,
+	KTT_GIC_DIST_BEFORE,
+	KTT_GIC_DIST_AFTER,
+	KTT_GIC_CPU_BEFORE,
+	KTT_GIC_CPU_AFTER,
+	KTT_ITS_INIT_BEFORE,
+	KTT_ITS_INIT_AFTER,
+	KTT_ITS_CPU_BEFORE,
+	KTT_ITS_CPU_AFTER,
+	KTT_IRQ_ENABLE_BEFORE,
+	KTT_IRQ_ENABLE_AFTER,
+	KTT_INIT_OWNER,
+	KTT_SMP_PREPARE_BEFORE,
+	KTT_SMP_PREPARE_AFTER,
+	KTT_SMP_BEFORE,
+	KTT_CPU_UP_BEFORE,
+	KTT_CPU_UP_AFTER,
+	KTT_SMP_AFTER,
+	KTT_STOP,
+};
+
+enum kexec_target_trace_stop_reason {
+	KTT_STOP_SMP_DONE = 1,
+	KTT_STOP_BACKEND_INIT,
+};
+
+#ifdef CONFIG_KEXEC_TARGET_TRACE
+void __init kexec_target_trace_start(void);
+void __init kexec_target_trace_mark(enum kexec_target_trace_stage stage,
+				 u64 a, u64 b, s64 result);
+void __init kexec_target_trace_handoff(void);
+bool __init kexec_target_trace_stop(unsigned int reason);
+#else
+static inline void kexec_target_trace_start(void) { }
+static inline void kexec_target_trace_mark(enum kexec_target_trace_stage stage,
+					u64 a, u64 b, s64 result) { }
+static inline void kexec_target_trace_handoff(void) { }
+static inline bool kexec_target_trace_stop(unsigned int reason) { return true; }
+#endif
+
+#endif /* _LINUX_KEXEC_TARGET_TRACE_H */
