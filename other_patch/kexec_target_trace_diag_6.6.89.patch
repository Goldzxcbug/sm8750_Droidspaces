--- /dev/null
+++ b/arch/arm64/kernel/kexec_target_trace.c
@@ -0,0 +1,411 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Bounded, single-owner target-startup trace for this diagnostic image only.
+ *
+ * This does not fix a kexec handoff.  It writes only an existing, validated
+ * qcom,ramoops console, after the incoming kernel allocated reserved memory.
+ * Source-side preparation must additionally verify that the existing zone has
+ * no ECC and that its complete physical parameters match the five fields.
+ * All code, state and BTMAP page tables are part of the linked kernel image.
+ */
+#include <linux/errno.h>
+#include <linux/init.h>
+#include <linux/irqflags.h>
+#include <linux/kconfig.h>
+#include <linux/kernel.h>
+#include <linux/kexec_target_trace.h>
+#include <linux/memblock.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/sched.h>
+#include <linux/sizes.h>
+
+#include <asm/barrier.h>
+#include <asm/cputype.h>
+#include <asm/early_ioremap.h>
+#include <asm/page.h>
+#include <asm/sysreg.h>
+
+#if !IS_BUILTIN(CONFIG_PSTORE_RAM)
+#error "KEXEC_TARGET_TRACE requires built-in ramoops_init() close guard"
+#endif
+
+/* Retain init lifetime while applying the same attributes as noinstr. */
+#define KTT_FN __noinstr_section(".init.text") __no_stack_protector
+#define KTT_SIG 0x43474244U
+#define KTT_CONSOLE_SIZE SZ_256K
+#define KTT_HEADER_SIZE 12U
+#define KTT_LINE_SIZE 256U
+
+struct ktt_ring {
+	u32 sig;
+	u32 start;
+	u32 used;
+	u8 data[];
+};
+
+struct ktt_config {
+	u64 base;
+	u64 region_size;
+	u64 console_size;
+	u64 capacity;
+	u64 run_id;
+	bool seen;
+	bool valid;
+};
+
+struct ktt_context {
+	struct ktt_ring *ring;
+	struct task_struct *owner;
+	u64 sequence;
+	unsigned long cache_line;
+	unsigned int error;
+	bool active;
+	bool busy;
+	bool closed;
+};
+
+/* No shared register-save area: each mark uses its caller's real C stack. */
+static struct ktt_config cfg __initdata;
+static struct ktt_context ctx __initdata;
+
+/* Exact syntax: five 0x-prefixed unsigned hexadecimal fields, comma-separated. */
+static KTT_FN int ktt_parse(char *arg)
+{
+	u64 fields[5];
+	unsigned int n, digits, d;
+	const char *p = arg;
+	u64 value;
+
+	/* Duplicate, malformed, or unsupported input never enables the trace. */
+	if (cfg.seen) {
+		cfg.valid = false;
+		return -EINVAL;
+	}
+	cfg.seen = true;
+	if (!p)
+		return -EINVAL;
+	for (n = 0; n < ARRAY_SIZE(fields); n++) {
+		if (p[0] != '0' || p[1] != 'x')
+			return -EINVAL;
+		p += 2;
+		value = 0;
+		for (digits = 0; ; digits++, p++) {
+			if (*p >= '0' && *p <= '9')
+				d = *p - '0';
+			else if (*p >= 'a' && *p <= 'f')
+				d = *p - 'a' + 10;
+			else if (*p >= 'A' && *p <= 'F')
+				d = *p - 'A' + 10;
+			else
+				break;
+			if (digits == 16)
+				return -EINVAL;
+			value = (value << 4) | d;
+		}
+		if (!digits)
+			return -EINVAL;
+		fields[n] = value;
+		if (n + 1 == ARRAY_SIZE(fields)) {
+			if (*p)
+				return -EINVAL;
+		} else if (*p++ != ',') {
+			return -EINVAL;
+		}
+	}
+	if (!fields[0] || !IS_ALIGNED(fields[0], PAGE_SIZE) ||
+	    !fields[1] || !IS_ALIGNED(fields[1], PAGE_SIZE) ||
+	    fields[1] > SZ_16M || fields[1] < fields[2] ||
+	    fields[0] + fields[1] < fields[0] ||
+	    fields[2] != KTT_CONSOLE_SIZE ||
+	    fields[3] != KTT_CONSOLE_SIZE - KTT_HEADER_SIZE || !fields[4])
+		return -EINVAL;
+	cfg.base = fields[0];
+	cfg.region_size = fields[1];
+	cfg.console_size = fields[2];
+	cfg.capacity = fields[3];
+	cfg.run_id = fields[4];
+	cfg.valid = true;
+	return 0;
+}
+early_param("kexec_late_trace", ktt_parse);
+
+/* Optional numeric properties must be well-formed zero, not merely unreadable. */
+static KTT_FN bool ktt_optional_zero(const struct device_node *np,
+				   const char *name)
+{
+	const struct property *prop;
+	int len;
+
+	prop = of_find_property(np, name, &len);
+	if (!prop)
+		return true;
+	return len == sizeof(__be32) && prop->value &&
+		be32_to_cpup(prop->value) == 0;
+}
+
+static KTT_FN bool ktt_validate_reserved_console(void)
+{
+	struct device_node *region, *consumer, *reference, *chosen;
+	struct reserved_mem *rmem;
+	phys_addr_t at;
+	u32 console, pmsg, memtype;
+	bool valid = false;
+
+	chosen = of_find_node_by_path("/chosen");
+	valid = chosen && of_property_read_bool(chosen, "linux,booted-from-kexec");
+	of_node_put(chosen);
+	if (!valid)
+		return false;
+	valid = false;
+	region = of_find_node_by_path("/reserved-memory/ramoops-region");
+	consumer = of_find_node_by_path("/soc/qcom_ramoops");
+	if (!region || !consumer)
+		goto out;
+	if (!of_device_is_available(region) ||
+	    !of_device_is_available(consumer) ||
+	    !of_device_is_compatible(consumer, "qcom,ramoops") ||
+	    !of_property_read_bool(region, "no-map") ||
+	    of_property_read_bool(region, "reusable"))
+		goto out;
+	reference = of_parse_phandle(consumer, "memory-region", 0);
+	if (reference != region) {
+		of_node_put(reference);
+		goto out;
+	}
+	of_node_put(reference);
+	rmem = of_reserved_mem_lookup(region);
+	if (!rmem || rmem->base != cfg.base || rmem->size != cfg.region_size)
+		goto out;
+	if (of_property_read_u32(consumer, "console-size", &console) ||
+	    of_property_read_u32(consumer, "pmsg-size", &pmsg) ||
+	    of_property_read_u32(consumer, "mem-type", &memtype) ||
+	    console != cfg.console_size || pmsg != cfg.region_size - console ||
+	    memtype != 2 ||
+	    !ktt_optional_zero(consumer, "record-size") ||
+	    !ktt_optional_zero(consumer, "ftrace-size") ||
+	    !ktt_optional_zero(consumer, "ecc-size") ||
+	    !ktt_optional_zero(region, "ecc-size"))
+		goto out;
+	/* RAM, completely NOMAP.  is_region_reserved() only tests any overlap. */
+	if (!memblock_is_region_memory(cfg.base, cfg.region_size))
+		goto out;
+	for (at = cfg.base; at < cfg.base + cfg.region_size; at += PAGE_SIZE)
+		if (memblock_is_map_memory(at))
+			goto out;
+	valid = true;
+out:
+	of_node_put(consumer);
+	of_node_put(region);
+	return valid;
+}
+
+static KTT_FN void ktt_cache_range(unsigned long start, unsigned long end,
+				 bool invalidate)
+{
+	unsigned long p;
+
+	for (p = start & ~(ctx.cache_line - 1); p < end; p += ctx.cache_line) {
+		if (invalidate)
+			asm volatile("dc civac, %0" : : "r" (p) : "memory");
+		else
+			asm volatile("dc cvac, %0" : : "r" (p) : "memory");
+	}
+	dsb(sy);
+}
+
+static KTT_FN bool ktt_header_valid(u32 *start, u32 *used)
+{
+	if (READ_ONCE(ctx.ring->sig) != KTT_SIG)
+		return false;
+	*start = READ_ONCE(ctx.ring->start);
+	*used = READ_ONCE(ctx.ring->used);
+	return *start < cfg.capacity && *used <= cfg.capacity && *start <= *used;
+}
+
+static KTT_FN unsigned int ktt_text(char *out, unsigned int pos,
+				 const char *text)
+{
+	while (*text && pos < KTT_LINE_SIZE)
+		out[pos++] = *text++;
+	return pos;
+}
+
+static KTT_FN unsigned int ktt_hex(char *out, unsigned int pos, u64 value,
+				unsigned int digits)
+{
+	unsigned int d;
+
+	while (digits && pos < KTT_LINE_SIZE) {
+		d = (value >> (--digits * 4)) & 15;
+		out[pos++] = d < 10 ? '0' + d : 'a' + d - 10;
+	}
+	return pos;
+}
+
+/* Called with local IRQs saved, the unique owner checked, and busy set. */
+static KTT_FN void ktt_emit(enum kexec_target_trace_stage stage,
+			 u64 a, u64 b, s64 result)
+{
+	char line[KTT_LINE_SIZE];
+	volatile u8 *data = ctx.ring->data;
+	unsigned int len = 0, i, first;
+	u32 start, used, next, new_used, sum = 2166136261U;
+	unsigned long base = (unsigned long)ctx.ring;
+
+	if (!ktt_header_valid(&start, &used)) {
+		ctx.error = 4;
+		ctx.active = false;
+		return;
+	}
+	len = ktt_text(line, len, "\nKEXEC_LATE_V1 run=");
+	len = ktt_hex(line, len, cfg.run_id, 16);
+	len = ktt_text(line, len, " seq=");
+	len = ktt_hex(line, len, ++ctx.sequence, 16);
+	len = ktt_text(line, len, " stage=");
+	len = ktt_hex(line, len, stage, 8);
+	len = ktt_text(line, len, " mpidr=");
+	len = ktt_hex(line, len, read_sysreg(mpidr_el1) & MPIDR_HWID_BITMASK, 16);
+	len = ktt_text(line, len, " a=");
+	len = ktt_hex(line, len, a, 16);
+	len = ktt_text(line, len, " b=");
+	len = ktt_hex(line, len, b, 16);
+	len = ktt_text(line, len, " ret=");
+	len = ktt_hex(line, len, (u64)result, 16);
+	for (i = 0; i < len; i++)
+		sum = (sum ^ (u8)line[i]) * 16777619U;
+	len = ktt_text(line, len, " sum=");
+	len = ktt_hex(line, len, sum, 8);
+	len = ktt_text(line, len, "\n");
+	/* Fixed format fits 256 bytes.  Refuse rather than publish truncation. */
+	if (len >= KTT_LINE_SIZE) {
+		ctx.error = 5;
+		ctx.active = false;
+		return;
+	}
+	first = min_t(unsigned int, len, cfg.capacity - start);
+	for (i = 0; i < first; i++)
+		data[start + i] = line[i];
+	ktt_cache_range(base + KTT_HEADER_SIZE + start,
+			base + KTT_HEADER_SIZE + start + first, false);
+	for (i = first; i < len; i++)
+		data[i - first] = line[i];
+	if (len > first)
+		ktt_cache_range(base + KTT_HEADER_SIZE,
+				base + KTT_HEADER_SIZE + len - first, false);
+	next = start + len;
+	if (next >= cfg.capacity)
+		next -= cfg.capacity;
+	new_used = min_t(u32, cfg.capacity, used + len);
+	/* Data is already at PoC.  Growing used before advancing start keeps
+	 * each intermediate header structurally bounded across interruption.
+	 * A reset can still leave an incomplete record; the FNV sum detects it.
+	 */
+	WRITE_ONCE(ctx.ring->used, new_used);
+	ktt_cache_range(base, base + KTT_HEADER_SIZE, false);
+	WRITE_ONCE(ctx.ring->start, next);
+	ktt_cache_range(base, base + KTT_HEADER_SIZE, false);
+}
+
+KTT_FN void kexec_target_trace_mark(enum kexec_target_trace_stage stage,
+				  u64 a, u64 b, s64 result)
+{
+	unsigned long flags;
+
+	local_irq_save(flags);
+	if (!ctx.closed && ctx.active && ctx.owner == current && !ctx.busy) {
+		ctx.busy = true;
+		ktt_emit(stage, a, b, result);
+		ctx.busy = false;
+	}
+	local_irq_restore(flags);
+}
+
+KTT_FN void kexec_target_trace_start(void)
+{
+	u32 start, used;
+	unsigned long line;
+
+	if (ctx.closed || ctx.ring || !cfg.valid || current != &init_task)
+		return;
+	if (!ktt_validate_reserved_console()) {
+		ctx.error = 1;
+		return;
+	}
+	line = 4UL << ((read_sysreg(ctr_el0) >> 16) & 15);
+	if (line < 16 || line > PAGE_SIZE) {
+		ctx.error = 2;
+		return;
+	}
+	ctx.cache_line = line;
+	/* PAGE_KERNEL/Normal-WB mapping, not the default Device early_ioremap. */
+	ctx.ring = early_memremap(cfg.base, cfg.console_size);
+	if (!ctx.ring) {
+		ctx.error = 3;
+		return;
+	}
+	ktt_cache_range((unsigned long)ctx.ring,
+			(unsigned long)ctx.ring + cfg.console_size, true);
+	if (!ktt_header_valid(&start, &used)) {
+		ctx.error = 4;
+		early_memunmap(ctx.ring, cfg.console_size);
+		ctx.ring = NULL;
+		return;
+	}
+	ctx.owner = &init_task;
+	ctx.active = true;
+	kexec_target_trace_mark(KTT_SETUP_ARCH_DONE, cfg.base, cfg.region_size, 0);
+}
+
+KTT_FN void kexec_target_trace_handoff(void)
+{
+	unsigned long flags;
+	bool transferred = false;
+
+	local_irq_save(flags);
+	/* A rejected header can disable output while still holding the lease. */
+	if (!ctx.closed && ctx.ring && !ctx.busy &&
+	    ctx.owner == &init_task && current->pid == 1) {
+		ctx.owner = current;
+		transferred = true;
+	}
+	local_irq_restore(flags);
+	if (transferred)
+		kexec_target_trace_mark(KTT_INIT_OWNER, 1, 0, 0);
+}
+
+/* Both call sites execute sequentially in the boot control task, before any
+ * ramoops backend registration.  The built-in postcore guard is a backstop
+ * even when no trace was requested or a previous validation rejected it.
+ */
+KTT_FN bool kexec_target_trace_stop(unsigned int reason)
+{
+	unsigned long flags;
+	void *mapping;
+	bool closed = false;
+
+	local_irq_save(flags);
+	/* A recursive/non-owner stop must not unmap an outer emit's storage.
+	 * The backend caller checks false and refuses to register its writer.
+	 */
+	if (ctx.busy || (ctx.owner && ctx.owner != current))
+		goto out;
+	if (!ctx.closed) {
+		if (ctx.active && !ctx.busy && ctx.owner == current) {
+			ctx.busy = true;
+			ktt_emit(KTT_STOP, reason, 0, 0);
+			ctx.busy = false;
+		}
+		ctx.active = false;
+		ctx.closed = true;
+		mapping = ctx.ring;
+		ctx.ring = NULL;
+		ctx.owner = NULL;
+		if (mapping)
+			early_memunmap(mapping, cfg.console_size);
+	}
+	closed = true;
+out:
+	local_irq_restore(flags);
+	return closed;
+}
