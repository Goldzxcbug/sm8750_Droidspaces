From: local kexec diagnosis
Subject: [DIAG] Request software control for one already-forced UFS aux RCG

Requires kexec_ufs_aux_force_diag_6.6.89.patch, SHA256
4863884ac5e9beaecfa74f731c2e02039127fa5f588a9476498bd9162897596d.
Its resulting gcc-sun.c is SHA256
48b93e2c613827abed465ace55171f3f9c44e44e8b1fce98146ae6c54867c4e3.

An independent default-false0400 module parameter acts only after every
existing force diagnostic guard, its FORCE_ENABLE_RCG OR and KUFSAUX1 log.
Clear only HW_CLK_CTRL_MODE on gcc_ufs_phy_phy_aux_clk_src.flags, retain
FORCE and all other flags, and report before/after flags with KUFSAUX2.
The existing provider handles hardware configuration in its normal
lifecycle. No new MMIO, clocks, retries, timeout or reset sequence is added.
Original provider error/return limitations remain. This is a bounded
software-control-mode experiment, not a production handoff repair.

--- a/drivers/clk/qcom/gcc-sun.c
+++ b/drivers/clk/qcom/gcc-sun.c
@@ -24,6 +24,11 @@
 #include "common.h"
 #include "reset.h"
 #include "vdd-level.h"
+
+static bool kexec_ufs_aux_swctrl_diag;
+module_param(kexec_ufs_aux_swctrl_diag, bool, 0400);
+MODULE_PARM_DESC(kexec_ufs_aux_swctrl_diag,
+                "Kexec-only UFS auxiliary RCG software-control experiment; requires force diagnostic");
 
 static bool kexec_ufs_aux_force_diag;
 module_param(kexec_ufs_aux_force_diag, bool, 0400);
@@ -3701,6 +3706,19 @@
 		 (unsigned long)gcc_ufs_phy_phy_aux_clk_src.flags,
 		 (unsigned long)FORCE_ENABLE_RCG,
 		 !!(gcc_ufs_phy_phy_aux_clk_src.flags & HW_CLK_CTRL_MODE));
+
+	/* Independent opt-in, after every force guard and the original OR/log. */
+	if (!READ_ONCE(kexec_ufs_aux_swctrl_diag))
+		return;
+
+	old_flags = gcc_ufs_phy_phy_aux_clk_src.flags;
+	gcc_ufs_phy_phy_aux_clk_src.flags &= ~HW_CLK_CTRL_MODE;
+	dev_info(&pdev->dev,
+		 "KUFSAUX2 stage=before-clock-registration clock=gcc_ufs_phy_phy_aux_clk_src flags_before=%lx flags_after=%lx force_kept=%u hw_ctrl=%u\n",
+		 old_flags,
+		 (unsigned long)gcc_ufs_phy_phy_aux_clk_src.flags,
+		 !!(gcc_ufs_phy_phy_aux_clk_src.flags & FORCE_ENABLE_RCG),
+		 !!(gcc_ufs_phy_phy_aux_clk_src.flags & HW_CLK_CTRL_MODE));
 }
 
 static int gcc_sun_probe(struct platform_device *pdev)
