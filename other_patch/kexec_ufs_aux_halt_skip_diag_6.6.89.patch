From: local kexec diagnosis
Subject: [DIAG] Bypass halt validation for one guarded UFS AUX leaf

Apply after the frozen force and software-control diagnostics. Baseline
vendor gcc-sun.c SHA256 is
 de5a28d89926907b1cf3d422178640fb6c37a136c744afce3542eb8bab2b1599.

Default-false 0400 kexec_ufs_aux_halt_skip_diag acts only after all original
force/kexec/Sun guards and the enabled SWCTRL path, after KUFSAUX1/2 logs.
Assign exactly BRANCH_HALT_SKIP (3) to this single AUX leaf halt_check;
never OR it with the old VOTED value. Preserve original clock data, flags,
ops, register writes and probe error flow. Log the old/new software value.

This intentionally bypasses halt validation (including the original
voted-disable delay and timeout dump). A callback return of zero is not
hardware-clock-on evidence. This is a single-variable diagnostic, not a
production fix. No new register reads, writes, reset, clock or retry calls.

--- a/drivers/clk/qcom/gcc-sun.c
+++ b/drivers/clk/qcom/gcc-sun.c
@@ -24,6 +24,11 @@
 #include "common.h"
 #include "reset.h"
 #include "vdd-level.h"
+
+static bool kexec_ufs_aux_halt_skip_diag;
+module_param(kexec_ufs_aux_halt_skip_diag, bool, 0400);
+MODULE_PARM_DESC(kexec_ufs_aux_halt_skip_diag,
+                "Kexec-only UFS auxiliary leaf halt-check bypass; requires force and software-control diagnostics");
 
 static bool kexec_ufs_aux_swctrl_diag;
 module_param(kexec_ufs_aux_swctrl_diag, bool, 0400);
@@ -3692,6 +3697,7 @@
 static void gcc_sun_kexec_aux_force_diag(struct platform_device *pdev)
 {
 	unsigned long old_flags;
+	unsigned int old_halt_check;
 
 	if (!READ_ONCE(kexec_ufs_aux_force_diag) || !of_chosen ||
 	    !of_property_read_bool(of_chosen, "linux,booted-from-kexec") ||
@@ -3719,6 +3725,17 @@
 		 (unsigned long)gcc_ufs_phy_phy_aux_clk_src.flags,
 		 !!(gcc_ufs_phy_phy_aux_clk_src.flags & FORCE_ENABLE_RCG),
 		 !!(gcc_ufs_phy_phy_aux_clk_src.flags & HW_CLK_CTRL_MODE));
