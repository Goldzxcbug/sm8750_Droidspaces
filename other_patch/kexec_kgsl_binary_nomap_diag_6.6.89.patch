+#ifdef CONFIG_ARM64_KEXEC_KGSL_NOMAP_FDT_DIAG
+static int __init kgpum_fdt_setup(char *arg)
+{
+	if (kgpum_fdt_seen)
+		kgpum_fdt_bad = true;
+	kgpum_fdt_seen = true;
+	if (!arg || strcmp(arg, "1"))
+		kgpum_fdt_bad = true;
+	return 0;
+}
+early_param("kexec_diag.kgsl_nomap_fdt", kgpum_fdt_setup);
+
+/* IEEE/zlib CRC of ordinary metadata, without early CPU-feature assumptions. */
+static u32 __init kgpum_crc32(const void *buffer, size_t len)
+{
+	const u8 *p = buffer;
+	u32 crc = ~0U;
+	unsigned int bit;
+
+	while (len--) {
+		crc ^= *p++;
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ (0xedb88320U & (0U - (crc & 1U)));
+	}
+	return crc ^ ~0U;
+}
+
+static int __init kgpum_decode_blob(const void *blob, int len)
+{
+	const u8 *p = blob;
+	u64 base, size, end, total = 0, declared;
+	u32 count, crc;
+	unsigned int i;
+
+	if (!blob || len < KGPUM_BINARY_HEADER || len > KGPUM_BINARY_MAX_BLOB ||
+	    memcmp(p, "KGPURNG1", 8) || fdt32_ld((const fdt32_t *)(p + 8)) != 1 ||
+	    fdt32_ld((const fdt32_t *)(p + 12)) != KGPUM_BINARY_ENTRY)
+		return -EINVAL;
+	count = fdt32_ld((const fdt32_t *)(p + 16));
+	crc = fdt32_ld((const fdt32_t *)(p + 20));
+	declared = fdt64_ld((const fdt64_t *)(p + 24));
+	if (!count || count > KGPUM_BINARY_MAX_RANGES ||
+	    len != KGPUM_BINARY_HEADER + count * KGPUM_BINARY_ENTRY ||
+	    !declared || declared > KGPUM_MAX_BYTES ||
+	    crc != kgpum_crc32(p + KGPUM_BINARY_HEADER, len - KGPUM_BINARY_HEADER))
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		const u8 *entry = p + KGPUM_BINARY_HEADER + i * KGPUM_BINARY_ENTRY;
+
+		base = fdt64_ld((const fdt64_t *)entry);
+		size = fdt64_ld((const fdt64_t *)(entry + 8));
+		if (!size || !IS_ALIGNED(base, PAGE_SIZE) || !IS_ALIGNED(size, PAGE_SIZE) ||
+		    check_add_overflow(base, size, &end) || end <= base ||
+		    check_add_overflow(total, size, &total) || total > KGPUM_MAX_BYTES ||
+		    (i && base < kgpum_ranges[i - 1].base + kgpum_ranges[i - 1].size))
+			return -EINVAL;
+		kgpum_ranges[i] = (struct kgpum_range) { base, size };
+	}
+	if (total != declared)
+		return -EINVAL;
+	kgpum_count = count;
+	kgpum_total = total;
+	kgpum_body_crc = crc;
+	kgpum_blob_crc = kgpum_crc32(blob, len);
+	return 0;
+}
+#endif
