+/* Used only to record provenance during the existing early init paths. */
+static bool its_kexec_reserved(phys_addr_t addr, unsigned long size)
+{
+	phys_addr_t start, end;
+	unsigned int scanned = 0;
+	u64 i;
+
+	if (!addr || !size || addr + size < addr ||
+	    !memblock_is_region_memory(addr, size))
+		return false;
+	for_each_reserved_mem_range(i, &start, &end) {
+		if (++scanned > 1024)
+			return false;
+		if (addr >= start && addr + size <= end)
+			return true;
+	}
+	return false;
+}
