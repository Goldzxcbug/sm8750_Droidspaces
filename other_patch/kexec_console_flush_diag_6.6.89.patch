+#ifdef CONFIG_KEXEC_RAMOOPS_FLUSH_DIAG
+/* This intentionally expensive diagnostic runs only after a console write.
+ * No allocation, logging, active wait, new mapping or non-console write path.
+ * The normal probe created the zone; recheck its ownership and mapping bounds
+ * before issuing VA cache operations, including its persistent header.
+ */
+static void notrace ramoops_flush_console_diag(struct ramoops_context *cxt)
+{
+	struct persistent_ram_zone *prz = cxt->cprz;
+	unsigned long start, size;
+	phys_addr_t offset;
+
+	if (!READ_ONCE(ramoops_console_flush_diag) || cxt->memtype != 2 ||
+	    !prz || !prz->vaddr || (void *)prz->buffer != prz->vaddr ||
+	    prz->type != PSTORE_TYPE_CONSOLE || prz->ecc_info.ecc_size)
+		return;
+	start = (unsigned long)prz->vaddr;
+	size = prz->size;
+	if (!size || size != cxt->console_size || size <= 12 ||
+	    prz->buffer_size != size - 12 ||
+	    !PAGE_ALIGNED(start) || !PAGE_ALIGNED(size) ||
+	    !PAGE_ALIGNED(prz->paddr) || start + size <= start ||
+	    prz->paddr < cxt->phys_addr)
+		return;
+	offset = prz->paddr - cxt->phys_addr;
+	if (offset > cxt->size || size > cxt->size - offset)
+		return;
+	if (!pfn_valid(prz->paddr >> PAGE_SHIFT))
+		return;
+	/* CVAC covers header plus all data. The helper ends with DSB SY;
+	 * keep the completion explicit here for this diagnostic contract too.
+	 */
+	dcache_clean_poc(start, start + size);
+	dsb(sy);
+}
+#else
+static inline void ramoops_flush_console_diag(struct ramoops_context *cxt) { }
+#endif
