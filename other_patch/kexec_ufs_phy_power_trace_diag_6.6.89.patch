+/* Diagnostic reads only; use the real vendor API instead of a CONFIG stub. */
+extern void gdsc_debug_print_regs(struct regulator *regulator);
+
+static bool kexec_ufs_phy_power_trace_diag;
+module_param(kexec_ufs_phy_power_trace_diag, bool, 0400);
+MODULE_PARM_DESC(kexec_ufs_phy_power_trace_diag,
+		"Trace existing Sun PHY power calls during explicit kexec diagnosis");
+
+static bool ufs_qcom_phy_power_trace_enabled(struct ufs_qcom_phy *phy)
+{
+	return kexec_ufs_phy_power_trace_diag && of_chosen &&
+		of_property_read_bool(of_chosen, "linux,booted-from-kexec") &&
+		of_device_is_compatible(phy->dev->of_node,
+					"qcom,ufs-phy-qmp-v4-sun") &&
+		phy->host_ctrl_rev_major == 6;
+}
+
+/* Mask order: GDSC, QREF, REFGEN, PHY, PLL, optional device pad rail. */
+static void ufs_qcom_phy_power_trace_state(struct ufs_qcom_phy *phy,
+					 bool diag, const char *stage,
+					 bool ret_valid, int ret)
+{
+	struct ufs_qcom_phy_vreg *rails[] = {
+		&phy->vdd_phy_gdsc, &phy->vdda_qref, &phy->vdda_refgen,
+		&phy->vdda_phy, &phy->vdda_pll, &phy->vddp_ref_clk,
+	};
+	u32 present = 0, enabled = 0;
+	int i;
+
+	if (!diag)
+		return;
+	for (i = 0; i < ARRAY_SIZE(rails); i++) {
+		if (!IS_ERR_OR_NULL(rails[i]->reg))
+			present |= BIT(i);
+		if (rails[i]->enabled)
+			enabled |= BIT(i);
+	}
+	dev_info(phy->dev,
+		 "UFSPWR1 stage=%s major=%u ref_cached=%u iface_cached=%u qref_present=%u aux_present=%u vreg_present_mask=%x vreg_enabled_mask=%x ret_valid=%u ret=%d\n",
+		 stage, phy->host_ctrl_rev_major, phy->is_ref_clk_enabled,
+		 phy->is_iface_clk_enabled, !IS_ERR_OR_NULL(phy->qref_clk),
+		 !IS_ERR_OR_NULL(phy->ref_aux_clk), present, enabled,
+		 ret_valid, ret);
+}
+
+static void ufs_qcom_phy_power_trace_gdsc(struct ufs_qcom_phy *phy,
+					bool diag, const char *stage)
+{
+	if (!diag || IS_ERR_OR_NULL(phy->vdd_phy_gdsc.reg))
+		return;
+	dev_info(phy->dev, "UFSPWR1 stage=%s provider=gdsc-regulator\n", stage);
+	gdsc_debug_print_regs(phy->vdd_phy_gdsc.reg);
+}
 
