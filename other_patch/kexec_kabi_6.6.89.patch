+/**
+ * kexec_trace_mark - record a handoff stage in the SoC IMEM window
+ * @stage: KX_STAGE_* value
+ *
+ * ioremap keeps the write legal while the MMU is still on.  The assembly
+ * side writes the same slot with plain physical stores once translation is
+ * off, so the last value found after the reset names the furthest stage.
+ */
+void kexec_trace_mark(unsigned int stage)
+{
+	void __iomem *slot;
+
+	slot = ioremap(KEXEC_TRACE_PHYS, sizeof(u32));
+	if (!slot)
+		return;
+	writel(stage, slot);
+	dsb(sy);
+	iounmap(slot);
+}
+
+void __nocfi machine_kexec(struct kimage *kimage)
 {
 	bool in_kexec_crash = (kimage == kexec_crash_image);
 	bool stuck_cpus = cpus_are_stuck_in_kernel();
 
+	kexec_trace_mark(KX_STAGE_ENTER);
+
 	/*
 	 * New cpus may have become stuck_in_kernel after we loaded the image.
 	 */
+	pr_emerg("KT: machine_kexec stuck=%d online=%d pkm=%d\n",
+		 stuck_cpus, num_online_cpus(), is_protected_kvm_enabled());
 	BUG_ON(!in_kexec_crash && (stuck_cpus || (num_online_cpus() > 1)));
 	WARN(in_kexec_crash && (stuck_cpus || smp_crash_stop_failed()),
 		"Some CPUs may be stale, kdump will be unreliable.\n");
@@ -205,6 +236,7 @@
 		typeof(cpu_soft_restart) *restart;
 
