 	kus_queue_mm(r);
+}
+
+/* Numeric VMA/file identity only; no pathname or file-backed ELF parsing. */
+struct kus_dabt_map {
+	unsigned long addr, start, end, pgoff, flags;
+	unsigned long ino;
+	u32 dev, generation;
+	bool found, file, regular;
+};
+
+void kexec_user_state_dabt(struct pt_regs *regs, unsigned long esr,
+			   unsigned long far)
+{
+	struct kus_dabt_map maps[2] = { };
+	struct mm_struct *mm = current->mm;
+	struct vm_area_struct *vma;
+	struct inode *inode;
+	char comm[TASK_COMM_LEN];
+	unsigned int role, i;
+	u32 insn = 0;
+	long insn_status = -EOPNOTSUPP;
+	bool context_ok, locked = false, attempted = false;
+
+	if (!smp_load_acquire(&kus_active) || !user_mode(regs) ||
+	    ESR_ELx_EC(esr) != ESR_ELx_EC_DABT_LOW)
+		return;
+	kus_comm(current, comm);
+	role = kus_role(current, comm);
+	if (!role || atomic_cmpxchg(&kus_dabt_seen, 0, 1))
+		return;
+
+	/* The call site passes original locals before thread ESR sanitization. */
+	kus_emit(&kus_dabt_budget, "KUSR2 kind=dabt first=1 role=%s pid=%d tgid=%d comm=%s pc=%lx lr=%lx sp=%lx pstate=%lx esr=%lx far=%lx far_valid=%u fatal_verdict=0\n",
+		 kus_role_name(role), task_pid_nr(current), task_tgid_nr(current),
+		 comm, (unsigned long)regs->pc, (unsigned long)regs->regs[30],
+		 (unsigned long)regs->sp, (unsigned long)regs->pstate,
+		 esr, far, !(esr & ESR_ELx_FnV));
+
+	/* The replay is immutable earlier metadata, never a fault-time scan. */
+	kexec_kgsl_nomap_diag_replay();
+	maps[0].addr = regs->pc;
+	maps[1].addr = regs->regs[30];
+	context_ok = mm && !in_interrupt() && !in_atomic() &&
+		     !irqs_disabled() && !faulthandler_disabled();
+	if (context_ok)
+		locked = mmap_read_trylock(mm);
+	if (!locked) {
+		kus_emit(&kus_dabt_budget, "KUSR2 kind=dabt-vma valid=0 result=%s context_ok=%u mmap_trylocked=0\n",
+			 context_ok ? "lock-busy" : "unsafe-context", context_ok);
+		goto code_result;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(maps); i++) {
+		vma = find_vma(mm, maps[i].addr);
+		if (!vma || maps[i].addr < vma->vm_start ||
+		    maps[i].addr >= vma->vm_end)
+			continue;
+		maps[i].found = true;
+		maps[i].start = vma->vm_start;
+		maps[i].end = vma->vm_end;
+		maps[i].pgoff = vma->vm_pgoff;
+		maps[i].flags = vma->vm_flags;
+		if (!vma->vm_file)
+			continue;
+		inode = file_inode(vma->vm_file);
+		maps[i].file = true;
+		maps[i].regular = S_ISREG(READ_ONCE(inode->i_mode));
+		maps[i].ino = READ_ONCE(inode->i_ino);
+		maps[i].dev = READ_ONCE(inode->i_sb->s_dev);
+		maps[i].generation = READ_ONCE(inode->i_generation);
+	}
+	/* Only the original user PC, not FAR, registers' targets or user stack. */
+	if (!compat_user_mode(regs) && IS_ALIGNED(regs->pc, sizeof(insn)) &&
+	    maps[0].found && maps[0].file && maps[0].regular &&
+	    (maps[0].flags & (VM_READ | VM_EXEC)) == (VM_READ | VM_EXEC) &&
+	    !(maps[0].flags & (VM_IO | VM_PFNMAP | VM_MIXEDMAP)) &&
+	    maps[0].end - regs->pc >= sizeof(insn)) {
+		attempted = true;
+		insn_status = copy_from_user_nofault(&insn,
+				(const void __user *)regs->pc, sizeof(insn));
+	}
+	mmap_read_unlock(mm);
+
+	/* All output is outside mmap_lock; copied values have explicit validity. */
+	for (i = 0; i < ARRAY_SIZE(maps); i++)
+		kus_emit(&kus_dabt_budget, "KUSR2 kind=dabt-vma reg=%s valid=%u raw=%lx start=%lx end=%lx pgoff=%lx flags=%lx file=%u regular=%u dev=%x ino=%lu generation=%x sync=1\n",
+			 i ? "lr" : "pc", maps[i].found, maps[i].addr,
+			 maps[i].start, maps[i].end, maps[i].pgoff, maps[i].flags,
+			 maps[i].file, maps[i].regular, maps[i].dev,
+			 maps[i].ino, maps[i].generation);
+code_result:
+	kus_emit(&kus_dabt_budget, "KUSR2 kind=pc-code bytes=4 attempted=%u valid=%u value=%08x result=%ld mmap_trylocked=%u context_ok=%u vma_readable=%u vma_executable=%u no_faultin=1\n",
+		 attempted, attempted && !insn_status, insn, insn_status,
+		 locked, context_ok, !!(maps[0].flags & VM_READ),
+		 !!(maps[0].flags & VM_EXEC));
 }
 
