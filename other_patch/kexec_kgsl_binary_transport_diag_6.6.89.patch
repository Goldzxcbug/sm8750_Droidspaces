@@ -0,0 +1,336 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Diagnostic transport of positive metadata; not an owner or quiescence seal. */
+#define pr_fmt(fmt) "kexec-kgsl: " fmt
+
+#include <linux/errno.h>
+#include <linux/kernel.h>
+#include <linux/kexec.h>
+#include <linux/libfdt.h>
+#include <linux/memblock.h>
+#include <linux/memory_hotplug.h>
+#include <linux/of_fdt.h>
+#include <linux/overflow.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <asm/kexec_kgsl.h>
+#include <asm/memory.h>
+#include <asm/sections.h>
+
+#define KGSL_KEY "kexec_diag.kgsl_nomap_fdt"
+#define KGSL_LEGACY "kexec_diag.kgsl_nomap"
+#define KGSL_PROPERTY "linux,kexec-kgsl-ranges"
+#define KGSL_HEADER 32U
+#define KGSL_ENTRY 16U
+#define KGSL_FOOTER 32U
+#define KGSL_MAX_RANGES 512U
+#define KGSL_MAX_BLOB (KGSL_HEADER + KGSL_MAX_RANGES * KGSL_ENTRY)
+
+struct kgsl_range {
+	u64 start;
+	u64 end;
+};
+
+struct arm64_kexec_kgsl {
+	u32 nr;
+	u32 blob_len;
+	u32 blob_crc;
+	u32 body_crc;
+	u64 total;
+	u64 initrd_prefix_len;
+	bool fdt_ready;
+	struct kgsl_range ranges[KGSL_MAX_RANGES];
+	u8 blob[KGSL_MAX_BLOB];
+};
+
+/* IEEE CRC32, identical to zlib.crc32; bounded metadata, not authentication. */
+static u32 kgsl_crc(const u8 *p, unsigned int bytes)
+{
+	u32 crc = ~0U;
+	unsigned int bit;
+
+	while (bytes--) {
+		crc ^= *p++;
+		for (bit = 0; bit < 8; bit++)
+			crc = (crc >> 1) ^ (0xedb88320U & (0U - (crc & 1)));
+	}
+	return crc ^ ~0U;
+}
+
+static u32 kgsl_u32(const void *p)
+{
+	return fdt32_ld(p);
+}
+
+static u64 kgsl_u64(const void *p)
+{
+	return fdt64_ld(p);
+}
+
+/* Do not inspect the initrd or allocate a cache without the explicit selector. */
+static int kgsl_requested(const char *cmdline)
+{
+	char *copy, *next, *param, *val;
+	unsigned int seen = 0;
+	bool bad = false, legacy = false;
+
+	if (!cmdline || !strstr(cmdline, KGSL_KEY))
+		return 0;
+	copy = kstrdup(cmdline, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+	next = copy;
+	while (*next) {
+		next = next_arg(next, &param, &val);
+		if (!strcmp(param, KGSL_LEGACY))
+			legacy = true;
+		if (strcmp(param, KGSL_KEY))
+			continue;
+		seen++;
+		if (!val || strcmp(val, "1"))
+			bad = true;
+	}
+	kfree(copy);
+	if (!seen)
+		return 0;
+	return seen == 1 && !bad && !legacy ? 1 : -EINVAL;
+}
+
+static int kgsl_no_inherited_property(void)
+{
+	const struct fdt_property *p;
+	int chosen, len;
+
+	if (!initial_boot_params || fdt_check_header(initial_boot_params))
+		return -EINVAL;
+	chosen = fdt_path_offset(initial_boot_params, "/chosen");
+	if (chosen < 0)
+		return -EINVAL;
+	p = fdt_get_property(initial_boot_params, chosen, KGSL_PROPERTY, &len);
+	return !p && len == -FDT_ERR_NOTFOUND ? 0 : -EEXIST;
+}
+
+/* Fill only once, before publication; never round, merge, or drop a tuple. */
+static int kgsl_decode(struct arm64_kexec_kgsl *g)
+{
+	u64 total = 0, previous = 0;
+	unsigned int i;
+
+	if (g->blob_len < KGSL_HEADER || g->blob_len > KGSL_MAX_BLOB ||
+	    memcmp(g->blob, "KGPURNG1", 8) || kgsl_u32(g->blob + 8) != 1 ||
+	    kgsl_u32(g->blob + 12) != KGSL_ENTRY)
+		return -EINVAL;
+	g->nr = kgsl_u32(g->blob + 16);
+	if (!g->nr || g->nr > KGSL_MAX_RANGES ||
+	    g->blob_len != KGSL_HEADER + g->nr * KGSL_ENTRY)
+		return -E2BIG;
+	g->body_crc = kgsl_u32(g->blob + 20);
+	if (kgsl_crc(g->blob + KGSL_HEADER, g->nr * KGSL_ENTRY) != g->body_crc)
+		return -EBADMSG;
+	for (i = 0; i < g->nr; i++) {
+		const u8 *entry = g->blob + KGSL_HEADER + i * KGSL_ENTRY;
+		u64 start = kgsl_u64(entry), size = kgsl_u64(entry + 8), end;
+
+		if (!size || !IS_ALIGNED(start, SZ_4K) || !IS_ALIGNED(size, SZ_4K) ||
+		    check_add_overflow(start, size, &end) || end - 1 > PHYS_MASK ||
+		    (i && start < previous) ||
+		    check_add_overflow(total, size, &total) || total > SZ_64M)
+			return -ERANGE;
+		g->ranges[i].start = start;
+		g->ranges[i].end = end;
+		previous = end;
+	}
+	if (!total || kgsl_u64(g->blob + 24) != total)
+		return -EINVAL;
+	g->total = total;
+	return 0;
+}
+
+static int kgsl_source_ram(const struct arm64_kexec_kgsl *g)
+{
+	u64 kernel = __pa_symbol(_text), kernel_end = __pa_symbol(_end);
+	u64 fdt_start = initial_boot_params_pa, fdt_end;
+	unsigned int i;
+	int ret = 0;
+
+	if (check_add_overflow(fdt_start, (u64)fdt_totalsize(initial_boot_params),
+			       &fdt_end))
+		return -EOVERFLOW;
+	/* Prevent hotplug replacing/frees of the ordinary memblock arrays here. */
+	get_online_mems();
+	for (i = 0; i < g->nr; i++) {
+		u64 p, start = g->ranges[i].start, end = g->ranges[i].end;
+
+		if ((start < kernel_end && end > kernel) ||
+		    (start < fdt_end && end > fdt_start) ||
+		    !memblock_is_region_memory(start, end - start)) {
+			ret = -EADDRINUSE;
+			break;
+		}
+		for (p = start; p < end; p += SZ_4K)
+			if (!memblock_is_map_memory(p)) {
+				ret = -EADDRNOTAVAIL;
+				break;
+			}
+		if (ret)
+			break;
+	}
+	put_online_mems();
+	return ret;
+}
+
+int arch_kexec_prepare_file_buffers(struct kimage *image)
+{
+	struct arm64_kexec_kgsl *g;
+	const u8 *footer, *blob;
+	u64 prefix, expected;
+	u32 blob_len, blob_crc;
+	int ret;
+
+	ret = kgsl_requested(image->cmdline_buf);
+	if (ret <= 0)
+		return ret;
+	if (!image->file_mode || image->type != KEXEC_TYPE_DEFAULT ||
+	    PAGE_SIZE != SZ_4K || image->arch.kgsl || image->nr_segments ||
+	    !image->initrd_buf || image->initrd_buf_len < KGSL_FOOTER)
+		return -EINVAL;
+	ret = kgsl_no_inherited_property();
+	if (ret)
+		return ret;
+	footer = (u8 *)image->initrd_buf + image->initrd_buf_len - KGSL_FOOTER;
+	if (memcmp(footer, "KGPULT01", 8) || kgsl_u32(footer + 8) != 1 ||
+	    kgsl_u32(footer + 28))
+		return -EINVAL;
+	blob_len = kgsl_u32(footer + 12);
+	prefix = kgsl_u64(footer + 16);
+	blob_crc = kgsl_u32(footer + 24);
+	if (blob_len < KGSL_HEADER || blob_len > KGSL_MAX_BLOB || !prefix ||
+	    check_add_overflow(prefix, (u64)blob_len + KGSL_FOOTER, &expected) ||
+	    expected != image->initrd_buf_len)
+		return -EINVAL;
+	blob = (u8 *)image->initrd_buf + prefix;
+	if (kgsl_crc(blob, blob_len) != blob_crc)
+		return -EBADMSG;
+	g = kvzalloc(sizeof(*g), GFP_KERNEL);
+	if (!g)
+		return -ENOMEM;
+	g->blob_len = blob_len;
+	g->blob_crc = blob_crc;
+	g->initrd_prefix_len = prefix;
+	memcpy(g->blob, blob, blob_len);
+	ret = kgsl_decode(g);
+	if (!ret)
+		ret = kgsl_source_ram(g);
+	if (ret) {
+		kvfree(g);
+		return ret;
+	}
+	/* Own the copy through kimage destruction, not file post-load cleanup. */
+	image->arch.kgsl = g;
+	image->initrd_buf_len = prefix;
+	pr_info("KGPUS1 action=capture ranges=%u total=%llu blob_crc32=%08x initrd_prefix=%llu historical=1 non_atomic=1\n",
+		g->nr, g->total, g->blob_crc, g->initrd_prefix_len);
+	return 0;
+}
+
+unsigned int arm64_kexec_kgsl_fdt_size(struct kimage *image)
+{
+	struct arm64_kexec_kgsl *g = image->arch.kgsl;
+
+	return g ? g->blob_len + sizeof(KGSL_PROPERTY) + 128 : 0;
+}
+
+int arm64_kexec_kgsl_fdt_setup(struct kimage *image, void *fdt)
+{
+	struct arm64_kexec_kgsl *g = image->arch.kgsl;
+	const void *prop;
+	int chosen, len, ret;
+
+	if (!g)
+		return 0;
+	g->fdt_ready = false;
+	chosen = fdt_path_offset(fdt, "/chosen");
+	if (chosen < 0)
+		return -EINVAL;
+	if (fdt_get_property(fdt, chosen, KGSL_PROPERTY, &len) ||
+	    len != -FDT_ERR_NOTFOUND)
+		return -EEXIST;
+	ret = fdt_setprop(fdt, chosen, KGSL_PROPERTY, g->blob, g->blob_len);
+	if (ret)
+		return ret;
+	chosen = fdt_path_offset(fdt, "/chosen");
+	prop = fdt_getprop(fdt, chosen, KGSL_PROPERTY, &len);
+	if (!prop || len != g->blob_len || memcmp(prop, g->blob, len))
+		return -EBADMSG;
+	g->fdt_ready = true;
+	return 0;
+}
+
+int arm64_kexec_kgsl_overlap(struct kimage *image, unsigned long start,
+		unsigned long end, bool top_down, unsigned long *hit_start,
+		unsigned long *hit_end)
+{
+	struct arm64_kexec_kgsl *g = image->arch.kgsl;
+	unsigned int i;
+	int found = 0;
+
+	if (!g)
+		return 0;
+	if (!g->nr || g->nr > KGSL_MAX_RANGES || start >= end)
+		return -EINVAL;
+	for (i = 0; i < g->nr; i++) {
+		if (g->ranges[i].start >= end)
+			break;
+		if (g->ranges[i].end <= start)
+			continue;
+		*hit_start = g->ranges[i].start;
+		*hit_end = g->ranges[i].end;
+		found = 1;
+		if (top_down)
+			break;
+	}
+	return found;
+}
+
+/* Cache/segment consistency only: this never queries live GPU ownership. */
+int arm64_kexec_kgsl_check(struct kimage *image)
+{
+	struct arm64_kexec_kgsl *g = image->arch.kgsl;
+	unsigned int i;
+
+	if (!g)
+		return 0;
+	if (!image->file_mode || !g->fdt_ready || !g->nr ||
+	    g->nr > KGSL_MAX_RANGES || g->blob_len != KGSL_HEADER + g->nr * KGSL_ENTRY ||
+	    g->blob_len > KGSL_MAX_BLOB || !g->initrd_prefix_len ||
+	    !g->total || g->total > SZ_64M ||
+	    kgsl_crc(g->blob, g->blob_len) != g->blob_crc ||
+	    kgsl_u32(g->blob + 16) != g->nr || kgsl_u64(g->blob + 24) != g->total)
+		return -ESTALE;
+	for (i = 0; i < g->nr; i++) {
+		const u8 *entry = g->blob + KGSL_HEADER + i * KGSL_ENTRY;
+
+		if (g->ranges[i].start != kgsl_u64(entry) ||
+		    g->ranges[i].end - g->ranges[i].start != kgsl_u64(entry + 8))
+			return -ESTALE;
+	}
+	if (image->nr_segments > KEXEC_SEGMENT_MAX)
+		return -EINVAL;
+	for (i = 0; i < image->nr_segments; i++) {
+		unsigned long start = image->segment[i].mem, end, a, b;
+		int ret;
+
+		if (!image->segment[i].memsz ||
+		    check_add_overflow(start, image->segment[i].memsz, &end))
+			return -EINVAL;
+		ret = arm64_kexec_kgsl_overlap(image, start, end, false, &a, &b);
+		if (ret)
+			return ret < 0 ? ret : -EADDRINUSE;
+	}
+	return 0;
+}
+
+void arm64_kexec_kgsl_cleanup(struct kimage *image)
+{
+	kvfree(image->arch.kgsl);
+	image->arch.kgsl = NULL;
+}
