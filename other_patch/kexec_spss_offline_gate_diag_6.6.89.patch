+#if IS_ENABLED(CONFIG_REMOTEPROC_KEXEC_OFFLINE_GATE)
+/* Immutable after release publication. Keep all references until reset. */
+struct rproc_kexec_gate {
+	struct rproc *rproc;
+	struct device *parent;
+	struct device_node *node;
+	struct module *owner;
+};
+
+static struct rproc_kexec_gate rproc_kexec_gate;
+static struct rproc_kexec_gate *rproc_kexec_sealed;
+static DEFINE_RAW_SPINLOCK(rproc_kexec_gate_lock);
+static unsigned int rproc_kexec_active;
+
+static bool rproc_kexec_matches(struct rproc *rproc,
+				const struct rproc_kexec_gate *gate)
+{
+	struct device *parent = rproc->dev.parent;
+
+	return gate && (rproc == gate->rproc || parent == gate->parent ||
+		       (parent && gate->node && dev_of_node(parent) == gate->node));
+}
+
+static bool rproc_kexec_blocked(struct rproc *rproc)
+{
+	return rproc_kexec_matches(rproc, smp_load_acquire(&rproc_kexec_sealed));
+}
+
+/*
+ * Count whole core operations, without holding a new lock across callbacks.
+ * Sealing conservatively refuses any active operation, including one on an
+ * unrelated remoteproc. This closes registration/auto-boot publication races.
+ */
+static int rproc_kexec_begin(struct rproc *rproc)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	raw_spin_lock_irqsave(&rproc_kexec_gate_lock, flags);
+	if (rproc_kexec_matches(rproc, rproc_kexec_sealed))
+		ret = -ESHUTDOWN;
+	else if (rproc_kexec_active == UINT_MAX)
+		ret = -EOVERFLOW;
+	else
+		rproc_kexec_active++;
+	raw_spin_unlock_irqrestore(&rproc_kexec_gate_lock, flags);
+	return ret;
+}
+
+static void rproc_kexec_end(void)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&rproc_kexec_gate_lock, flags);
+	if (!WARN_ON_ONCE(!rproc_kexec_active))
+		rproc_kexec_active--;
+	raw_spin_unlock_irqrestore(&rproc_kexec_gate_lock, flags);
+}
+
+int rproc_kexec_seal_offline(struct rproc *rproc)
+{
+	struct rproc_kexec_gate candidate = {};
+	struct device *parent;
+	struct rproc *entry;
+	unsigned long flags;
+	bool registered = false;
+	int ret = -EBUSY;
+
+	if (!rproc)
+		return -EINVAL;
+	if (!READ_ONCE(kexec_in_progress) || !READ_ONCE(pm_freezing))
+		return -EPERM;
+	if (smp_load_acquire(&rproc_kexec_sealed))
+		return -EALREADY;
+
+	parent = rproc->dev.parent;
+	if (!parent)
+		return -ENODEV;
+	/* Match driver removal order; never keep either mutex after returning. */
+	if (!device_trylock(parent))
+		return -EBUSY;
+	if (!parent->driver || !dev_of_node(parent)) {
+		ret = -ENODEV;
+		goto unlock_parent;
+	}
+	if (!mutex_trylock(&rproc->lock))
+		goto unlock_parent;
+	if (rproc->state != RPROC_OFFLINE || atomic_read(&rproc->power) ||
+	    rproc->auto_boot || !rproc->recovery_disabled)
+		goto unlock_rproc;
+	if (!mutex_trylock(&rproc_list_mutex))
+		goto unlock_rproc;
+
+	candidate.rproc = rproc;
+	candidate.parent = parent;
+	candidate.node = dev_of_node(parent);
+	candidate.owner = parent->driver->owner;
+	list_for_each_entry(entry, &rproc_list, node) {
+		if (entry == rproc)
+			registered = true;
+		else if (rproc_kexec_matches(entry, &candidate))
+			goto unlock_list;
+	}
+	if (!registered) {
+		ret = -ENODEV;
+		goto unlock_list;
+	}
+	if (!try_module_get(candidate.owner)) {
+		ret = -ENODEV;
+		goto unlock_list;
+	}
+	get_device(&rproc->dev);
+	get_device(parent);
+	of_node_get(candidate.node);
+
+	raw_spin_lock_irqsave(&rproc_kexec_gate_lock, flags);
+	if (rproc_kexec_sealed) {
+		ret = -EALREADY;
+	} else if (rproc_kexec_active) {
+		ret = -EBUSY;
+	} else {
+		rproc_kexec_gate = candidate;
+		smp_store_release(&rproc_kexec_sealed, &rproc_kexec_gate);
+		ret = 0;
+	}
+	raw_spin_unlock_irqrestore(&rproc_kexec_gate_lock, flags);
+	if (ret) {
+		of_node_put(candidate.node);
+		put_device(parent);
+		put_device(&rproc->dev);
+		/* Do not rediscover owner through rproc_put() after unbind. */
+		module_put(candidate.owner);
+	}
+
+unlock_list:
+	mutex_unlock(&rproc_list_mutex);
+unlock_rproc:
+	mutex_unlock(&rproc->lock);
+unlock_parent:
+	device_unlock(parent);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(rproc_kexec_seal_offline);
+#else
+static bool rproc_kexec_blocked(struct rproc *rproc)
+{
+	return false;
+}
+
+static int rproc_kexec_begin(struct rproc *rproc)
+{
+	return 0;
+}
+
+static void rproc_kexec_end(void)
+{
+}
+#endif
 
