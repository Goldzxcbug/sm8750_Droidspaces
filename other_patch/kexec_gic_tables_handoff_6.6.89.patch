+#ifdef CONFIG_ARM64_KEXEC_GIC_TABLES
+/* All limits apply to work inspected, not only to merged output intervals. */
+#define ITS_KEXEC_MAX_NODES	8
+#define ITS_KEXEC_MAX_DEVICES	256
+#define ITS_KEXEC_MAX_TABLE_SIZE	SZ_1M
+#define ITS_KEXEC_MAX_L1_ENTRIES	(SZ_1M / GITS_LVL1_ENTRY_SIZE)
+
+struct its_kexec_snapshot {
+	struct kexec_gic_range *ranges;
+	unsigned int nr_ranges;
+	unsigned int max_ranges;
+	unsigned int nr_devices;
+	unsigned int nr_l2_tables;
+	unsigned int l1_entries;
+};
+
+/* Keep sorted, merged intervals, without an allocation or a large stack. */
+static int its_kexec_add_range(struct its_kexec_snapshot *s,
+			       phys_addr_t start, unsigned long size)
+{
+	phys_addr_t end;
+	unsigned int i, j;
+
+	if (!start || !size || check_add_overflow(start, size, &end) ||
+	    check_add_overflow(end, (phys_addr_t)PAGE_SIZE - 1, &end))
+		return -ERANGE;
+	start = round_down(start, PAGE_SIZE);
+	end = round_down(end, PAGE_SIZE);
+	if (end <= start)
+		return -ERANGE;
+
+	for (i = 0; i < s->nr_ranges && s->ranges[i].end < start; i++)
+		;
+	for (j = i; j < s->nr_ranges && s->ranges[j].start <= end; j++) {
+		start = min(start, s->ranges[j].start);
+		end = max(end, s->ranges[j].end);
+	}
+	if (j == i) {
+		if (s->nr_ranges == s->max_ranges)
+			return -E2BIG;
+		memmove(s->ranges + i + 1, s->ranges + i,
+			(s->nr_ranges - i) * sizeof(*s->ranges));
+		s->nr_ranges++;
+	} else {
+		memmove(s->ranges + i + 1, s->ranges + j,
+			(s->nr_ranges - j) * sizeof(*s->ranges));
+		s->nr_ranges -= j - i - 1;
+	}
+	s->ranges[i].start = start;
+	s->ranges[i].end = end;
+	return 0;
+}
+
+/* These pointers come from live driver allocations, never from an MMIO PA. */
+static int its_kexec_add_owned(struct its_kexec_snapshot *s, void *ptr,
+			       unsigned long size, phys_addr_t *pa)
+{
+	unsigned long va = (unsigned long)ptr;
+	phys_addr_t addr;
+
+	if (!ptr || !size || size > ITS_KEXEC_MAX_TABLE_SIZE ||
+	    va + size - 1 < va || !virt_addr_valid(ptr) ||
+	    !virt_addr_valid((void *)(va + size - 1)))
+		return -EOPNOTSUPP;
+	addr = virt_to_phys(ptr);
+	if (!page_count(compound_head(virt_to_page(ptr))))
+		return -EOPNOTSUPP;
+	if (pa)
+		*pa = addr;
+	return its_kexec_add_range(s, addr, size);
+}
+
+static int its_kexec_lpi_ranges(struct its_kexec_snapshot *s)
+{
+	phys_addr_t prop = gic_rdists->prop_table_pa, pa;
+	bool inherited = gic_rdists->flags & RDIST_FLAGS_RD_TABLES_PREALLOCATED;
+	unsigned int ncpus = 0;
+	int cpu, ret;
+
+	if (lpi_id_bits < 14 || lpi_id_bits > ITS_MAX_LPI_NRBITS ||
+	    !prop || !IS_ALIGNED(prop, SZ_64K) ||
+	    !gic_rdists->prop_table_va ||
+	    gic_rdists->has_vlpis || gic_rdists->has_rvpeid)
+		return -EOPNOTSUPP;
+	if (inherited) {
+		if (!its_kexec_inherited_prop_valid)
+			return -EOPNOTSUPP;
+		ret = its_kexec_add_range(s, prop, LPI_PROPBASE_SZ);
+	} else {
+		ret = its_kexec_add_owned(s, gic_rdists->prop_table_va,
+					 LPI_PROPBASE_SZ, &pa);
+		if (!ret && pa != prop)
+			ret = -EIO;
+	}
+	if (ret)
+		return ret;
+
+	for_each_possible_cpu(cpu) {
+		void __iomem *base = gic_data_rdist_cpu(cpu)->rd_base;
+		struct page *pend = gic_data_rdist_cpu(cpu)->pend_page;
+		u64 flags = gic_data_rdist_cpu(cpu)->flags;
+		u64 propbaser, pendbaser, typer;
+		u32 ctlr;
+
+		if (++ncpus > KEXEC_GIC_MAX_RANGES || !base ||
+		    !(flags & RD_LOCAL_LPI_ENABLED) ||
+		    gic_data_rdist_cpu(cpu)->vpe_l1_base)
+			return -EOPNOTSUPP;
+		typer = gic_read_typer(base + GICR_TYPER);
+		if (!(typer & GICR_TYPER_PLPIS) || (typer & GICR_TYPER_VLPIS))
+			return -EOPNOTSUPP;
+		ctlr = readl_relaxed(base + GICR_CTLR);
+		if (!(ctlr & GICR_CTLR_ENABLE_LPIS) || (ctlr & GICR_CTLR_RWP))
+			return -EBUSY;
+		propbaser = gicr_read_propbaser(base + GICR_PROPBASER);
+		pendbaser = gicr_read_pendbaser(base + GICR_PENDBASER);
+		if (GICR_PROPBASER_ADDRESS(propbaser) != prop ||
+		    (propbaser & GICR_PROPBASER_IDBITS_MASK) + 1 != lpi_id_bits)
+			return -EIO;
+
+		/* Keep spare allocations too, including those of offline CPUs. */
+		if (pend) {
+			ret = its_kexec_add_owned(s, page_address(pend),
+						 LPI_PENDBASE_SZ, &pa);
+			if (ret)
+				return ret;
+		}
+		if (flags & RD_LOCAL_PENDTABLE_PREALLOCATED) {
+			if (!inherited ||
+			    !per_cpu(its_kexec_inherited_pending_valid, cpu))
+				return -EOPNOTSUPP;
+			pa = per_cpu(its_kexec_inherited_pending, cpu);
+			ret = its_kexec_add_range(s, pa, LPI_PENDBASE_SZ);
+			if (ret)
+				return ret;
+		} else if (!pend) {
+			return -EOPNOTSUPP;
+		}
+		if (!IS_ALIGNED(pa, SZ_64K) ||
+		    GICR_PENDBASER_ADDRESS(pendbaser) != pa)
+			return -EIO;
+		ctlr = readl_relaxed(base + GICR_CTLR);
+		if (!(ctlr & GICR_CTLR_ENABLE_LPIS) || (ctlr & GICR_CTLR_RWP))
+			return -EBUSY;
+	}
+	return ncpus ? 0 : -EOPNOTSUPP;
+}
+
+static int its_kexec_baser_ranges(struct its_kexec_snapshot *s,
+				 struct its_node *its, struct its_baser *baser)
+{
+	unsigned long size, entries, i;
+	phys_addr_t pa, hwpa;
+	u64 val = its_read_baser(its, baser);
+	int ret;
+
+	if (!(val & GITS_BASER_VALID))
+		return (baser->base || (baser->val & GITS_BASER_VALID)) ? -EIO : 0;
+	if (val != baser->val || !baser->base ||
+	    baser->order > get_order(ITS_KEXEC_MAX_TABLE_SIZE) ||
+	    (GITS_BASER_TYPE(val) != GITS_BASER_TYPE_DEVICE &&
+	     GITS_BASER_TYPE(val) != GITS_BASER_TYPE_COLLECTION))
+		return -EOPNOTSUPP;
+	size = PAGE_ORDER_TO_SIZE(baser->order);
+	switch (val & GITS_BASER_PAGE_SIZE_MASK) {
+	case GITS_BASER_PAGE_SIZE_4K:
+		if (baser->psz != SZ_4K)
+			return -EIO;
+		hwpa = val & GENMASK_ULL(47, 12);
+		break;
+	case GITS_BASER_PAGE_SIZE_16K:
+		if (baser->psz != SZ_16K)
+			return -EIO;
+		hwpa = val & GENMASK_ULL(47, 12);
+		break;
+	case GITS_BASER_PAGE_SIZE_64K:
+		if (baser->psz != SZ_64K)
+			return -EIO;
+		hwpa = GITS_BASER_ADDR_48_to_52(val);
+		break;
+	default:
+		return -EOPNOTSUPP;
+	}
+	if (GITS_BASER_NR_PAGES(val) * baser->psz != size)
+		return -EIO;
+	ret = its_kexec_add_owned(s, baser->base, size, &pa);
+	if (ret)
+		return ret;
+	if (hwpa != pa || !IS_ALIGNED(pa, baser->psz))
+		return -EIO;
+	if (!(val & GITS_BASER_INDIRECT))
+		return 0;
+	if (GITS_BASER_TYPE(val) != GITS_BASER_TYPE_DEVICE)
+		return -EOPNOTSUPP;
+	entries = size / GITS_LVL1_ENTRY_SIZE;
+	if (entries > ITS_KEXEC_MAX_L1_ENTRIES - s->l1_entries)
+		return -E2BIG;
+	s->l1_entries += entries;
+	for (i = 0; i < entries; i++) {
+		/* Only the driver writes L1 entries; snapshot_lock holds them stable. */
+		u64 entry = le64_to_cpu(READ_ONCE(((__le64 *)baser->base)[i]));
+
+		if (!entry)
+			continue;
+		if (++s->nr_l2_tables > KEXEC_GIC_MAX_RANGES)
+			return -E2BIG;
+		if (!(entry & GITS_BASER_VALID) ||
+		    (entry & ~(GITS_BASER_VALID | GENMASK_ULL(51, PAGE_SHIFT))))
+			return -EOPNOTSUPP;
+		pa = entry & ~GITS_BASER_VALID;
+		if (!pa || !IS_ALIGNED(pa, baser->psz) ||
+		    !pfn_valid(PHYS_PFN(pa)) ||
+		    !pfn_valid(PHYS_PFN(pa + baser->psz - 1)))
+			return -EOPNOTSUPP;
+		/* The driver's own L1 entry is the ownership record for this L2. */
+		ret = its_kexec_add_owned(s, phys_to_virt(pa), baser->psz, NULL);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+static int its_kexec_node_ranges(struct its_kexec_snapshot *s, struct its_node *its)
+{
+	struct its_device *dev;
+	phys_addr_t pa;
+	u64 cbaser, rd, wr;
+	unsigned long write, base;
+	unsigned int i;
+	int ret;
+
+	if (!its->base || is_v4(its) || is_v4_1(its) || its->pre_its_base ||
+	    gic_read_typer(its->base + GITS_TYPER) != its->typer ||
+	    !(its->typer & GITS_TYPER_PLPIS))
+		return -EOPNOTSUPP;
+	if (!(readl_relaxed(its->base + GITS_CTLR) & GITS_CTLR_ENABLE))
+		return -EBUSY;
+	cbaser = gits_read_cbaser(its->base + GITS_CBASER);
+	if (!(cbaser & GITS_CBASER_VALID) ||
+	    ((cbaser & 0xff) + 1) * SZ_4K != ITS_CMD_QUEUE_SZ)
+		return -EIO;
+	ret = its_kexec_add_owned(s, its->cmd_base, ITS_CMD_QUEUE_SZ, &pa);
+	if (ret)
+		return ret;
+	if (GITS_CBASER_ADDRESS(cbaser) != pa)
+		return -EIO;
+	base = (unsigned long)its->cmd_base;
+	write = (unsigned long)its->cmd_write;
+	if (write < base || write - base >= ITS_CMD_QUEUE_SZ ||
+	    !IS_ALIGNED(write - base, sizeof(struct its_cmd_block)))
+		return -EIO;
+	wr = readq_relaxed(its->base + GITS_CWRITER);
+	rd = readq_relaxed(its->base + GITS_CREADR);
+	/* Reject pending or stalled commands; never poll for completion here. */
+	if (wr != write - base || rd != wr)
+		return -EBUSY;
+
+	for (i = 0; i < GITS_BASER_NR_REGS; i++) {
+		ret = its_kexec_baser_ranges(s, its, &its->tables[i]);
+		if (ret)
+			return ret;
+	}
+	list_for_each_entry(dev, &its->its_device_list, entry) {
+		unsigned long size;
+
+		if (++s->nr_devices > ITS_KEXEC_MAX_DEVICES)
+			return -E2BIG;
+		if (dev->its != its || dev->nr_ites < 2 ||
+		    dev->nr_ites > BIT(ITS_MAX_LPI_NRBITS) ||
+		    !is_power_of_2(dev->nr_ites) || dev->event_map.vm ||
+		    dev->event_map.vlpi_maps || dev->event_map.nr_vlpis)
+			return -EOPNOTSUPP;
+		size = dev->nr_ites *
+			(FIELD_GET(GITS_TYPER_ITT_ENTRY_SIZE, its->typer) + 1);
+		size = max_t(unsigned long, size, ITS_ITT_ALIGN) + ITS_ITT_ALIGN - 1;
+		/* Preserve the whole raw allocation, including hardware alignment slack. */
+		ret = its_kexec_add_owned(s, dev->itt, size, NULL);
+		if (ret)
+			return ret;
+	}
+	return 0;
+}
+
+int gic_v3_kexec_snapshot(struct kexec_gic_range *ranges,
+			 unsigned int max_ranges)
+{
+	struct its_kexec_snapshot s = {
+		.ranges = ranges,
+		.max_ranges = max_ranges,
+	};
+	struct its_node *its;
+	unsigned int nr_nodes = 0;
+	unsigned long flags;
+	int ret;
+
+	if (!ranges || !max_ranges || max_ranges > KEXEC_GIC_MAX_RANGES)
+		return -EINVAL;
+	local_irq_save(flags);
+	if (!raw_spin_trylock(&its_kexec_snapshot_lock)) {
+		ret = -EBUSY;
+		goto irq_out;
+	}
+	if (its_kexec_mutators) {
+		ret = -EBUSY;
+		goto gate_out;
+	}
+	if (!its_kexec_probe_ready || !gic_rdists || !gic_rdists->rdist) {
+		ret = -EOPNOTSUPP;
+		goto gate_out;
+	}
+	if (!raw_spin_trylock(&its_lock)) {
+		ret = -EBUSY;
+		goto gate_out;
+	}
+	if (list_empty(&its_nodes)) {
+		ret = -EOPNOTSUPP;
+		goto nodes_out;
+	}
+	ret = its_kexec_lpi_ranges(&s);
+	if (ret)
+		goto nodes_out;
+	list_for_each_entry(its, &its_nodes, entry) {
+		if (++nr_nodes > ITS_KEXEC_MAX_NODES) {
+			ret = -E2BIG;
+			goto nodes_out;
+		}
+		if (!raw_spin_trylock(&its->lock)) {
+			ret = -EBUSY;
+			goto nodes_out;
+		}
+		ret = its_kexec_node_ranges(&s, its);
+		raw_spin_unlock(&its->lock);
+		if (ret)
+			goto nodes_out;
+	}
+	ret = s.nr_ranges;
+nodes_out:
+	raw_spin_unlock(&its_lock);
+gate_out:
+	raw_spin_unlock(&its_kexec_snapshot_lock);
+irq_out:
+	local_irq_restore(flags);
+	return ret;
+}
