diff --git a/drivers/clk/clk.c b/drivers/clk/clk.c
--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -98,6 +98,56 @@
 	struct kref		ref;
 };
 
+/*
+ * Temporary kexec-only UFS clock diagnosis.  These are metadata snapshots,
+ * taken under enable_lock; prepare_count is sampled with READ_ONCE because
+ * prepare_lock is a separate lock.  No clock operation is invoked here.
+ * Logging with IRQs off can perturb timing and does not prove hardware state.
+ */
+static bool kexec_ufs_clk_trace_requested __ro_after_init;
+static bool kexec_ufs_clk_trace_seen __initdata;
+
+static int __init kexec_ufs_clk_trace_setup(char *arg)
+{
+	if (kexec_ufs_clk_trace_seen || !arg || strcmp(arg, "1")) {
+		kexec_ufs_clk_trace_seen = true;
+		kexec_ufs_clk_trace_requested = false;
+		return -EINVAL;
+	}
+
+	kexec_ufs_clk_trace_seen = true;
+	kexec_ufs_clk_trace_requested = true;
+	return 0;
+}
+early_param("kexec_diag.ufs_clocks", kexec_ufs_clk_trace_setup);
+
+static bool kexec_ufs_clk_trace_match(struct clk_core *core)
+{
+	if (!kexec_ufs_clk_trace_requested ||
+	    (strcmp(core->name, "gcc_ufs_phy_phy_aux_clk_src") &&
+	     strcmp(core->name, "gcc_ufs_phy_phy_aux_clk")))
+		return false;
+
+	/* of_chosen is established after the early parameter was parsed. */
+	return of_chosen &&
+		of_property_present(of_chosen, "linux,booted-from-kexec");
+}
+
+static void kexec_ufs_clk_trace(struct clk_core *core, const char *event,
+			      int ret, bool ret_valid)
+{
+	struct clk_core *parent = core->parent;
+
+	pr_emerg("KUFSCLK: event=%s name=%.64s enable=%u prepare=%u parent=%.64s parent_enable=%u parent_prepare=%u has_enable=%u has_disable=%u ret_valid=%u ret=%d\n",
+		 event, core->name, READ_ONCE(core->enable_count),
+		 READ_ONCE(core->prepare_count), parent ? parent->name : "<none>",
+		 parent ? READ_ONCE(parent->enable_count) : 0,
+		 parent ? READ_ONCE(parent->prepare_count) : 0,
+		 (unsigned int)!!core->ops->enable,
+		 (unsigned int)!!core->ops->disable,
+		 (unsigned int)ret_valid, ret);
+}
+
 #define CREATE_TRACE_POINTS
 #include <trace/events/clk.h>
 
@@ -1175,29 +1225,53 @@
 
 static void clk_core_disable(struct clk_core *core)
 {
+	bool trace;
+
 	lockdep_assert_held(&enable_lock);
 
