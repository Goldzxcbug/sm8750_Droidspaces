+static_assert(offsetof(struct shrc_trace_desc, args) == 0x10);
+static_assert(offsetof(struct shrc_trace_desc, owner) == 0x60);
+static_assert(offsetof(struct shrc_trace_desc, allow_multi) == 0x64);
+
+static struct task_struct *shrc_trace_task;
+static const u64 *shrc_trace_owner_ptr;
+static const struct qcom_scm_vmperm *shrc_trace_dest_ptr;
+static unsigned long shrc_trace_public_sp;
+static unsigned long shrc_trace_lower_sp;
+static unsigned int shrc_trace_records;
+static unsigned int shrc_trace_registered;
+
+static int shrc_trace_pre(struct kprobe *kp, struct pt_regs *regs);
+static struct kprobe shrc_trace_probes[] = {
+	{ .symbol_name = "qcom_scm:qcom_scm_assign_mem", .pre_handler = shrc_trace_pre },
