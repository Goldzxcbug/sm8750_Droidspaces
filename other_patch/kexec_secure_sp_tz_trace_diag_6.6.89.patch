+/* Acquisition attempts are bounded; console_unlock may hand over or take time. */
+static void shrc_trace_drain(void)
+{
+	unsigned int i;
+
+	if (in_atomic() || irqs_disabled())
+		return;
+	for (i = 0; i < 10; i++) {
+		if (console_trylock()) {
+			console_unlock();
+			return;
+		}
+		if (i != 9)
+			msleep(1);
+	}
+}
