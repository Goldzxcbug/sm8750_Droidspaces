 			return ret;
+		}
 
 		trace_clk_enable(core);
 
-		if (core->ops->enable)
+		if (core->ops->enable) {
+			if (trace)
+				kexec_ufs_clk_trace(core, "enable.callback-begin", 0, false);
 			ret = core->ops->enable(core->hw);
+			if (trace)
+				kexec_ufs_clk_trace(core, "enable.callback-return", ret, true);
+		} else if (trace) {
+			kexec_ufs_clk_trace(core, "enable.no-callback", 0, false);
+		}
 
