-	if (WARN(core->enable_count == 0, "%s already disabled\n", core->name))
+	trace = kexec_ufs_clk_trace_match(core);
+	if (trace)
+		kexec_ufs_clk_trace(core, "disable.enter", 0, false);
+
+	if (WARN(core->enable_count == 0, "%s already disabled\n", core->name)) {
+		if (trace)
+			kexec_ufs_clk_trace(core, "disable.reject-zero", 0, false);
 		return;
+	}
 
 	if (WARN(core->enable_count == 1 && core->flags & CLK_IS_CRITICAL,
-	    "Disabling critical %s\n", core->name))
+	    "Disabling critical %s\n", core->name)) {
+		if (trace)
+			kexec_ufs_clk_trace(core, "disable.reject-critical", 0, false);
 		return;
-
-	if (--core->enable_count > 0)
+	}
+
+	if (--core->enable_count > 0) {
+		if (trace)
+			kexec_ufs_clk_trace(core, "disable.skip-count", 0, false);
 		return;
+	}
 
 	trace_clk_disable(core);
 
-	if (core->ops->disable)
+	if (core->ops->disable) {
+		if (trace)
+			kexec_ufs_clk_trace(core, "disable.callback-begin", 0, false);
 		core->ops->disable(core->hw);
+		if (trace)
+			kexec_ufs_clk_trace(core, "disable.callback-return", 0, false);
+	} else if (trace) {
+		kexec_ufs_clk_trace(core, "disable.no-callback", 0, false);
+	}
 
 	trace_clk_disable_complete(core);
 
 	clk_core_disable(core->parent);
+	if (trace)
+		kexec_ufs_clk_trace(core, "disable.return", 0, false);
 }
 
 static void clk_core_disable_lock(struct clk_core *core)
@@ -1233,36 +1307,60 @@
 static int clk_core_enable(struct clk_core *core)
 {
 	int ret = 0;
+	bool trace;
 
 	lockdep_assert_held(&enable_lock);
 
 	if (!core)
 		return 0;
 
