+static void its_kexec_mutation_end(void)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&its_kexec_snapshot_lock, flags);
+	its_kexec_mutators--;
+	raw_spin_unlock_irqrestore(&its_kexec_snapshot_lock, flags);
+}
