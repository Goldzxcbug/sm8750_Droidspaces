+	old_halt_check = gcc_ufs_phy_phy_aux_clk.halt_check;
+	gcc_ufs_phy_phy_aux_clk.halt_check = BRANCH_HALT_SKIP;
+	dev_info(&pdev->dev,
+		 "KUFSAUX3 stage=before-clock-registration clock=gcc_ufs_phy_phy_aux_clk old_halt_check=%u new_halt_check=%u\n",
