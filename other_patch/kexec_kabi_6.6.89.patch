+++ b/arch/arm64/include/asm/kexec_trace.h
@@ -0,0 +1,60 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Kexec handoff trace markers.
+ *
+ * Once machine_kexec() reaches cpu_soft_restart() the MMU and caches are being
+ * torn down and printk stops being a reliable observer.  Write a small value
+ * straight into the SoC IMEM window instead: fixed physical address, not
+ * cacheable by the kernel, and it survives the hard reset the watchdog issues
+ * when the handoff fails.
+ *
+ * Only the dedicated offset below is touched.  Every documented IMEM sub-node
+ * on this device sits far under it.
+ */
+#ifndef __ASM_KEXEC_TRACE_H
+#define __ASM_KEXEC_TRACE_H
+
+/* Base and size from /proc/device-tree/soc/qcom,msm-imem. */
+#define KEXEC_TRACE_IMEM_BASE	0x68140000UL
+#define KEXEC_TRACE_IMEM_SIZE	0x00100000UL
+
+/*
+ * 0xe000 is above every documented sub-node: mem_dump_table 0x010,
+ * dload_type 0x01c, diag_dload 0x0c8, restart_reason 0x65c, boot_stats 0x6b0,
+ * kaslr_offset 0x6d0, pil 0x6dc and 0x94c, sys_dbg 0xaf8.
+ */
+#define KEXEC_TRACE_OFFSET	0x0000e000UL
+#define KEXEC_TRACE_PHYS	(KEXEC_TRACE_IMEM_BASE + KEXEC_TRACE_OFFSET)
+
+/* Stage values, in the order the handoff passes through them. */
+#define KX_STAGE_ENTER			0x10
+#define KX_STAGE_AFTER_IDMAP		0x13
+#define KX_STAGE_SOFT_RESTART_ENTER	0x20
+#define KX_STAGE_MMU_OFF		0x21
+#define KX_STAGE_ABOUT_TO_BRANCH	0x22
+#define KX_STAGE_NEW_KERNEL		0x50
+
+#ifndef __ASSEMBLY__
+
+void kexec_trace_mark(unsigned int stage);
+
+#else
+
+/*
+ * Clobbers x9 and x10 only.  Both are dead at every call site:
+ * cpu_soft_restart() uses x0-x4, x8 and x12, and primary_entry() has not
+ * consumed anything beyond x0 yet.  Only call with the MMU off or through the
+ * identity map, otherwise the store faults.
+ */
+.macro kx_mark_asm stage
+	movz	x9, #((KEXEC_TRACE_PHYS >> 0) & 0xffff)
+	movk	x9, #((KEXEC_TRACE_PHYS >> 16) & 0xffff), lsl #16
+	movk	x9, #((KEXEC_TRACE_PHYS >> 32) & 0xffff), lsl #32
+	mov	w10, #\stage
+	str	w10, [x9]
+	dsb	sy
+.endm
+
+#endif /* __ASSEMBLY__ */
+
+#endif /* __ASM_KEXEC_TRACE_H */
