From: Codex diagnostics
Subject: [DIAG] arm64: retain and replay bounded KGSL NOMAP metadata

Parent is the frozen 4646 target. This records up to 32 ranges (512 bytes)
and the original successful apply count, samples full memblock NOMAP and
reserved coverage after async init and before free_initmem, then replays
only retained historical metadata on one diagnostic request. No backing
read, hardware change, allocation, release, new panic or owner claim.

--- a/arch/arm64/mm/init.c
+++ b/arch/arm64/mm/init.c
@@ -33,6 +33,9 @@
 #include <linux/acpi_iort.h>
 #include <linux/kmemleak.h>
 #ifndef __GENKSYMS__
+#include <linux/atomic.h>
+#include <linux/memory_hotplug.h>
+#include <asm/kexec_kgsl_diag.h>
 #include <linux/libfdt.h>
 #include <linux/overflow.h>
 #endif
@@ -344,6 +347,114 @@
 static u64 kgpum_total __initdata;
 static bool kgpum_seen __initdata;
 static bool kgpum_bad __initdata;
+
+/* Exactly 512 bytes of retained range metadata; no page backing is accessed. */
+static struct kgpum_range kgpum_diag_ranges[KGPUM_MAX_RANGES] __ro_after_init;
+static_assert(sizeof(kgpum_diag_ranges) == 512);
+static unsigned int kgpum_diag_count __ro_after_init;
+static unsigned int kgpum_diag_applied __ro_after_init;
+static unsigned int kgpum_diag_nomap_mask __ro_after_init;
+static unsigned int kgpum_diag_reserved_mask __ro_after_init;
+static unsigned long kgpum_diag_memory_regions __ro_after_init;
+static unsigned long kgpum_diag_reserved_regions __ro_after_init;
+static bool kgpum_diag_armed __ro_after_init;
+static bool kgpum_diag_checked __ro_after_init;
+static bool kgpum_diag_valid __ro_after_init;
+/* The fault-side once gate must remain writable after mark_readonly(). */
+static atomic_t kgpum_diag_replayed = ATOMIC_INIT(0);
+
+/* Check continuous union coverage, not the memblock "any overlap" helper. */
+static bool __init kgpum_diag_full_cover(const struct memblock_region *regions,
+		unsigned long count, phys_addr_t base, phys_addr_t size, bool nomap)
+{
+	phys_addr_t cursor = base, end, region_end;
+	unsigned long i;
+
+	if (!size || check_add_overflow(base, size, &end))
+		return false;
+	for (i = 0; i < count && cursor < end; i++) {
+		if (!regions[i].size)
+			continue;
+		if (check_add_overflow(regions[i].base, regions[i].size,
+				       &region_end))
+			return false;
+		if (region_end <= cursor)
+			continue;
+		if (regions[i].base > cursor ||
+		    (nomap && !(regions[i].flags & MEMBLOCK_NOMAP)))
+			return false;
+		cursor = min(end, region_end);
+	}
+	return cursor == end;
+}
+
+static void kgpum_diag_print(const char *phase)
+{
+	unsigned int i;
+
+	pr_emerg("KGPUM2 action=%s ranges=%u applied=%u checked=%u nomap_mask=%08x reserved_mask=%08x memory_regions=%lu reserved_regions=%lu historical=1 non_atomic=1\n",
+		 phase, kgpum_diag_count, kgpum_diag_applied, kgpum_diag_checked,
+		 kgpum_diag_nomap_mask, kgpum_diag_reserved_mask,
+		 kgpum_diag_memory_regions, kgpum_diag_reserved_regions);
+	for (i = 0; i < kgpum_diag_count; i++)
+		pr_emerg("KGPUM2 action=range phase=%s index=%u pfn=%llx pages=%llx nomap_full=%u reserved_full=%u\n",
+			 phase, i,
+			 (unsigned long long)(kgpum_diag_ranges[i].base >> PAGE_SHIFT),
+			 (unsigned long long)(kgpum_diag_ranges[i].size >> PAGE_SHIFT),
+			 !!(kgpum_diag_nomap_mask & BIT(i)),
+			 !!(kgpum_diag_reserved_mask & BIT(i)));
+}
+
+void __init kexec_kgsl_nomap_diag_snapshot(void)
+{
+	const struct memblock_region *memory, *reserved;
+	unsigned long memory_count, reserved_count;
+	unsigned int i;
+
+	if (!kgpum_diag_armed || kgpum_diag_valid)
+		return;
+	/* Other ARM64 configurations may have discarded these tables already. */
+	if (!IS_ENABLED(CONFIG_ARCH_KEEP_MEMBLOCK))
+		return;
+	/* Pin both array lifetimes against normal memory-hotplug writers. */
+	get_online_mems();
+	memory = READ_ONCE(memblock.memory.regions);
+	reserved = READ_ONCE(memblock.reserved.regions);
+	memory_count = READ_ONCE(memblock.memory.cnt);
+	reserved_count = READ_ONCE(memblock.reserved.cnt);
+	kgpum_diag_memory_regions = memory_count;
+	kgpum_diag_reserved_regions = reserved_count;
+	/* A rejected scan is explicit checked=0, never a fabricated coverage pass. */
+	kgpum_diag_checked = memory && reserved && memory_count && reserved_count &&
+		memory_count <= 4096 && reserved_count <= 4096;
+	if (kgpum_diag_checked) {
+		for (i = 0; i < kgpum_diag_count; i++) {
+			if (kgpum_diag_full_cover(memory, memory_count,
+					kgpum_diag_ranges[i].base,
+					kgpum_diag_ranges[i].size, true))
+				kgpum_diag_nomap_mask |= BIT(i);
+			if (kgpum_diag_full_cover(reserved, reserved_count,
+					kgpum_diag_ranges[i].base,
+					kgpum_diag_ranges[i].size, false))
+				kgpum_diag_reserved_mask |= BIT(i);
+		}
+	}
+	put_online_mems();
+	/* Publish a historical non-atomic metadata sample, not live ownership. */
+	smp_store_release(&kgpum_diag_valid, true);
+	kgpum_diag_print("snapshot");
+}
+
+void kexec_kgsl_nomap_diag_replay(void)
+{
+	if (!READ_ONCE(kgpum_diag_armed) ||
+	    !smp_load_acquire(&kgpum_diag_valid))
+		return;
+	if (atomic_cmpxchg(&kgpum_diag_replayed, 0, 1))
+		return;
+	/* No initdata, memblock walk, fault VA, PTE, or page backing read here. */
+	kgpum_diag_print("replay");
+}
 
 static int __init kgpum_hex(const char **cursor, u64 *value)
 {
@@ -529,6 +640,10 @@
 		    memblock_is_region_reserved(base, size))
 			kgpum_reject("RAM-map-or-reserved");
 	}
+	kgpum_diag_count = kgpum_count;
+	memcpy(kgpum_diag_ranges, kgpum_ranges,
+	       kgpum_count * sizeof(kgpum_diag_ranges[0]));
+	kgpum_diag_armed = true;
 	pr_info("KGPUM1 action=validated ranges=%u bytes=%llu sampled_only=1\n",
 		kgpum_count, (unsigned long long)kgpum_total);
 	for (i = 0; i < kgpum_count; i++) {
@@ -541,6 +656,7 @@
 			pr_emerg("KGPUM1 action=apply-failed index=%u error=%d\n", i, ret);
 			panic("KGPUM1 partial isolation cannot continue");
 		}
+		kgpum_diag_applied++;
 		pr_info("KGPUM1 action=nomap index=%u pfn=%llx pages=%llx sampled_only=1\n",
 			i, (unsigned long long)(base >> PAGE_SHIFT),
 			(unsigned long long)(size >> PAGE_SHIFT));
--- a/init/main.c
+++ b/init/main.c
@@ -107,6 +107,9 @@
 #include <asm/setup.h>
 #include <asm/sections.h>
 #include <asm/cacheflush.h>
+#ifdef CONFIG_ARM64
+#include <asm/kexec_kgsl_diag.h>
+#endif
 
 #define CREATE_TRACE_POINTS
 #include <trace/events/initcall.h>
@@ -1451,6 +1454,9 @@
 	kernel_init_freeable();
 	/* need to finish all async __init code before freeing the memory */
 	async_synchronize_full();
+#ifdef CONFIG_ARM64
+	kexec_kgsl_nomap_diag_snapshot();
+#endif
 
 	system_state = SYSTEM_FREEING_INITMEM;
 	kprobe_free_init_mem();
--- a/arch/arm64/include/asm/kexec_kgsl_diag.h
+++ b/arch/arm64/include/asm/kexec_kgsl_diag.h
@@ -0,0 +1,11 @@
