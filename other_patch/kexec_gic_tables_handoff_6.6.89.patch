+// SPDX-License-Identifier: GPL-2.0-only
+/* Preserve GIC-owned memory; this does not quiesce a GIC or an ITS. */
+#define pr_fmt(fmt) "kexec-gic: " fmt
+
+#include <linux/errno.h>
+#include <linux/kexec.h>
+#include <linux/kexec_gic.h>
+#include <linux/libfdt.h>
+#include <linux/of_fdt.h>
+#include <linux/overflow.h>
+#include <linux/slab.h>
+#include <linux/sort.h>
+
+#define GIC_NODE "kexec-gic-tables"
+#define GIC_VERSION "linux,kexec-gic-tables-version"
+#define GIC_VERSION_1 1
+
+struct arm64_kexec_gic {
+	unsigned int nr;
+	unsigned int address_cells;
+	unsigned int size_cells;
+	bool fdt_ready;
+	struct kexec_gic_range captured[KEXEC_GIC_MAX_RANGES];
+	/* Preallocated: final validation runs with interrupts disabled. */
+	struct kexec_gic_range scratch[KEXEC_GIC_MAX_RANGES];
+};
+
+static int range_compare(const void *a, const void *b)
+{
+	const struct kexec_gic_range *x = a, *y = b;
+
+	if (x->start != y->start)
+		return x->start < y->start ? -1 : 1;
+	return x->end == y->end ? 0 : (x->end < y->end ? -1 : 1);
+}
+
+static int normalize_ranges(struct kexec_gic_range *ranges, int nr,
+			    unsigned int max)
+{
+	unsigned int i, out = 0;
+
+	if (nr < 0)
+		return nr;
+	if (nr > max)
+		return -E2BIG;
+	for (i = 0; i < nr; i++) {
+		if (ranges[i].start >= ranges[i].end ||
+		    !IS_ALIGNED(ranges[i].start, PAGE_SIZE) ||
+		    !IS_ALIGNED(ranges[i].end, PAGE_SIZE))
+			return -EINVAL;
+	}
+	sort(ranges, nr, sizeof(*ranges), range_compare, NULL);
+	for (i = 0; i < nr; i++) {
+		if (out && ranges[i].start <= ranges[out - 1].end) {
+			ranges[out - 1].end = max(ranges[out - 1].end,
+						 ranges[i].end);
+		} else {
+			ranges[out++] = ranges[i];
+		}
+	}
+	return out;
+}
+
+/* Both inputs are normalized; adjacent captured intervals are already merged. */
+static bool ranges_subset(const struct kexec_gic_range *small, unsigned int ns,
+			  const struct kexec_gic_range *large, unsigned int nl)
+{
+	unsigned int i, j = 0;
+
+	for (i = 0; i < ns; i++) {
+		while (j < nl && large[j].end <= small[i].start)
+			j++;
+		if (j == nl || small[i].start < large[j].start ||
+		    small[i].end > large[j].end)
+			return false;
+	}
+	return true;
+}
+
+static int get_cells(const void *fdt, int node, const char *name)
+{
+	const fdt32_t *p;
+	int len;
+
+	p = fdt_getprop(fdt, node, name, &len);
+	if (!p || len != sizeof(*p))
+		return -EINVAL;
+	len = fdt32_to_cpu(*p);
+	return len == 1 || len == 2 ? len : -EINVAL;
+}
+
+/* Match the standard early reserved-memory scanner, including empty ranges. */
+static int check_root(const void *fdt, unsigned int *ac, unsigned int *sc)
+{
+	const void *p;
+	int a, s, node, len;
+
+	if (!fdt || fdt_check_header(fdt))
+		return -EINVAL;
+	a = get_cells(fdt, 0, "#address-cells");
+	s = get_cells(fdt, 0, "#size-cells");
+	if (a < 0 || s < 0)
+		return -EINVAL;
+	*ac = a;
+	*sc = s;
+	node = fdt_path_offset(fdt, "/reserved-memory");
+	if (node == -FDT_ERR_NOTFOUND)
+		return node;
+	if (node < 0 || get_cells(fdt, node, "#address-cells") != a ||
+	    get_cells(fdt, node, "#size-cells") != s)
+		return -EINVAL;
+	p = fdt_getprop(fdt, node, "ranges", &len);
+	if (!p || len)
+		return -EINVAL;
+	/* A disabled parent would prevent the generic scanner from reserving. */
+	p = fdt_getprop(fdt, node, "status", &len);
+	if (p && !((len == 5 && !memcmp(p, "okay", 5)) ||
+		   (len == 3 && !memcmp(p, "ok", 3))))
+		return -EINVAL;
+	return node;
+}
+
+/* libfdt's normal subnode lookup ignores unit addresses: require our exact name. */
+static int find_owned_node(const void *fdt, int root)
+{
+	int node, found = -FDT_ERR_NOTFOUND;
+
+	fdt_for_each_subnode(node, fdt, root) {
+		const char *name = fdt_get_name(fdt, node, NULL);
+		size_t len = strlen(GIC_NODE);
+
+		if (!name)
+			return -EINVAL;
+		if (strncmp(name, GIC_NODE, len) || (name[len] && name[len] != '@'))
+			continue;
+		if (name[len] || found != -FDT_ERR_NOTFOUND)
+			return -EINVAL;
+		found = node;
+	}
+	return node == -FDT_ERR_NOTFOUND ? found : -EINVAL;
+}
+
+static int check_owned_node(const void *fdt, int node)
+{
+	const fdt32_t *version;
+	const void *status;
+	int len;
+
+	version = fdt_getprop(fdt, node, GIC_VERSION, &len);
+	if (!version || len != sizeof(*version) ||
+	    fdt32_to_cpu(*version) != GIC_VERSION_1 ||
+	    fdt_getprop(fdt, node, "no-map", NULL) ||
+	    fdt_getprop(fdt, node, "reusable", NULL) ||
+	    fdt_first_subnode(fdt, node) != -FDT_ERR_NOTFOUND)
+		return -EINVAL;
+	status = fdt_getprop(fdt, node, "status", &len);
+	if (status && !((len == 5 && !memcmp(status, "okay", 5)) ||
+			(len == 3 && !memcmp(status, "ok", 3))))
+		return -EINVAL;
+	return 0;
+}
+
+static u64 next_cell(const fdt32_t **p, unsigned int cells)
+{
+	u64 value = fdt32_to_cpu(*(*p)++);
+
+	if (cells == 2)
+		value = (value << 32) | fdt32_to_cpu(*(*p)++);
+	return value;
+}
+
+static int read_ranges(const void *fdt, int node, const char *name,
+		       struct kexec_gic_range *out, unsigned int max,
+		       unsigned int ac, unsigned int sc)
+{
+	const fdt32_t *p;
+	unsigned int i, nr, tuple = (ac + sc) * sizeof(*p);
+	int len;
+
+	p = fdt_getprop(fdt, node, name, &len);
+	if (!p || len < 0 || len % tuple)
+		return -EINVAL;
+	nr = len / tuple;
+	if (nr > max)
+		return -E2BIG;
+	for (i = 0; i < nr; i++) {
+		u64 start = next_cell(&p, ac), size = next_cell(&p, sc), end;
+
+		if (check_add_overflow(start, size, &end) || !size)
+			return -EINVAL;
+		out[i].start = start;
+		out[i].end = end;
+	}
+	return normalize_ranges(out, nr, max);
+}
+
+static bool ranges_encodable(const struct kexec_gic_range *r, unsigned int nr,
+			     unsigned int ac, unsigned int sc)
+{
+	unsigned int i;
+
+	for (i = 0; i < nr; i++)
+		if ((ac == 1 && r[i].start > U32_MAX) ||
+		    (sc == 1 && r[i].end - r[i].start > U32_MAX))
+			return false;
+	return true;
+}
+
+/* Prior reg is validated for ownership, never accumulated into this snapshot. */
+static int validate_source_fdt(struct arm64_kexec_gic *gic)
+{
+	const void *fdt = initial_boot_params;
+	int root, node, ret;
+
+	root = check_root(fdt, &gic->address_cells, &gic->size_cells);
+	if (root < 0 && root != -FDT_ERR_NOTFOUND)
+		return root;
+	if (root >= 0) {
+		node = find_owned_node(fdt, root);
+		if (node < 0 && node != -FDT_ERR_NOTFOUND)
+			return node;
+		if (node >= 0) {
+			ret = check_owned_node(fdt, node);
+			if (ret)
+				return ret;
+			ret = read_ranges(fdt, node, "reg", gic->scratch,
+					  KEXEC_GIC_MAX_RANGES,
+					  gic->address_cells, gic->size_cells);
+			if (ret < 0)
+				return ret;
+		}
+	}
+	if (!ranges_encodable(gic->captured, gic->nr, gic->address_cells,
+			      gic->size_cells))
+		return -ERANGE;
+	return 0;
+}
+
+int arch_kexec_kernel_image_probe(struct kimage *image, void *buf,
+				 unsigned long buf_len)
+{
+	struct arm64_kexec_gic *gic;
+	int ret;
+
+	ret = kexec_image_probe_default(image, buf, buf_len);
+	if (ret)
+		return ret;
+	if (image->arch.gic_tables)
+		return -EEXIST;
+	gic = kzalloc(sizeof(*gic), GFP_KERNEL);
+	if (!gic)
+		return -ENOMEM;
+	ret = gic_v3_kexec_snapshot(gic->captured, KEXEC_GIC_MAX_RANGES);
+	ret = normalize_ranges(gic->captured, ret, KEXEC_GIC_MAX_RANGES);
+	if (ret < 0)
+		goto fail;
+	gic->nr = ret;
+	ret = validate_source_fdt(gic);
+	if (ret)
+		goto fail;
+	/* Probe precedes IMA and every image/initrd/DTB kexec_add_buffer call. */
+	image->arch.gic_tables = gic;
+	pr_info("captured %u hardware table ranges\n", gic->nr);
+	return 0;
+fail:
+	pr_err("cannot capture table reservations (%d)\n", ret);
+	kfree(gic);
+	return ret;
+}
+
+void arm64_kexec_gic_cleanup(struct kimage *image)
+{
+	kfree(image->arch.gic_tables);
+	image->arch.gic_tables = NULL;
+}
+
+static const struct kexec_gic_range *overlap(const struct arm64_kexec_gic *gic,
+					    unsigned long start,
+					    unsigned long end, bool top_down)
+{
+	const struct kexec_gic_range *found = NULL;
+	unsigned int i;
+
+	for (i = 0; i < gic->nr; i++) {
+		if (gic->captured[i].start >= end)
+			break;
+		if (gic->captured[i].end <= start)
+			continue;
+		found = &gic->captured[i];
+		if (top_down)
+			break;
+	}
+	return found;
+}
+
+int arch_kexec_locate_mem_hole(struct kexec_buf *kbuf)
+{
+	struct arm64_kexec_gic *gic = kbuf->image->arch.gic_tables;
+	const struct kexec_gic_range *hit;
+	unsigned long min = kbuf->buf_min, max = kbuf->buf_max, end;
+	bool fixed = kbuf->mem != KEXEC_BUF_MEM_UNKNOWN;
+	int ret;
+
+	if (!gic || !kbuf->memsz || min > max)
+		return -EINVAL;
+	for (;;) {
+		ret = kexec_locate_mem_hole(kbuf);
+		if (ret)
+			break;
+		if (check_add_overflow(kbuf->mem, kbuf->memsz, &end)) {
+			ret = -EOVERFLOW;
+			break;
+		}
+		if (kbuf->mem < kbuf->buf_min || end - 1 > kbuf->buf_max) {
+			ret = -EADDRNOTAVAIL;
+			break;
+		}
+		hit = overlap(gic, kbuf->mem, end, kbuf->top_down);
+		if (!hit)
+			break;
+		ret = -EADDRNOTAVAIL;
+		if (fixed)
+			break;
+		if (kbuf->top_down) {
+			if (!hit->start || hit->start - 1 < kbuf->buf_min)
+				break;
+			kbuf->buf_max = hit->start - 1;
+		} else {
+			if (hit->end > kbuf->buf_max)
+				break;
+			kbuf->buf_min = hit->end;
+		}
+		kbuf->mem = KEXEC_BUF_MEM_UNKNOWN;
+	}
+	/* Do not change the caller's placement policy for the next segment. */
+	kbuf->buf_min = min;
+	kbuf->buf_max = max;
+	if (ret && !fixed)
+		kbuf->mem = KEXEC_BUF_MEM_UNKNOWN;
+	return ret;
+}
+
+unsigned int arm64_kexec_gic_fdt_size(struct kimage *image)
+{
+	struct arm64_kexec_gic *gic = image->arch.gic_tables;
+
+	if (!gic)
+		return 0;
+	/* Actual tuple count plus node/property names and a possible new root. */
+	return gic->nr *
+		(gic->address_cells + gic->size_cells) * sizeof(fdt32_t) + 512;
+}
+
+static fdt32_t *put_cell(fdt32_t *p, u64 value, unsigned int cells)
+{
+	if (cells == 2)
+		*p++ = cpu_to_fdt32(value >> 32);
+	*p++ = cpu_to_fdt32(value);
+	return p;
+}
+
+static int write_ranges(void *fdt, int node, const char *name,
+			const struct kexec_gic_range *ranges, unsigned int nr,
+			unsigned int ac, unsigned int sc)
+{
+	fdt32_t *p;
+	void *data;
+	unsigned int i;
+	int ret;
+
+	ret = fdt_setprop_placeholder(fdt, node, name,
+				      nr * (ac + sc) * sizeof(*p), &data);
+	if (ret)
+		return ret;
+	p = data;
+	for (i = 0; i < nr; i++) {
+		p = put_cell(p, ranges[i].start, ac);
+		p = put_cell(p, ranges[i].end - ranges[i].start, sc);
+	}
+	return 0;
+}
+
+int arm64_kexec_gic_fdt_setup(struct kimage *image, void *fdt)
+{
+	struct arm64_kexec_gic *gic = image->arch.gic_tables;
+	unsigned int ac, sc;
+	int root, node, ret;
+
+	if (!gic)
+		return -EINVAL;
+	gic->fdt_ready = false;
+	root = check_root(fdt, &ac, &sc);
+	if (root < 0 && root != -FDT_ERR_NOTFOUND)
+		return root;
+	if (ac != gic->address_cells || sc != gic->size_cells)
+		return -EINVAL;
+	if (root == -FDT_ERR_NOTFOUND) {
+		root = fdt_add_subnode(fdt, 0, "reserved-memory");
+		if (root < 0)
+			return root;
+		ret = fdt_setprop_u32(fdt, root, "#address-cells", ac);
+		if (!ret)
+			ret = fdt_setprop_u32(fdt, root, "#size-cells", sc);
+		if (!ret)
+			ret = fdt_setprop(fdt, root, "ranges", NULL, 0);
+		if (ret)
+			return ret;
+	}
+	node = find_owned_node(fdt, root);
+	if (node == -FDT_ERR_NOTFOUND)
+		node = fdt_add_subnode(fdt, root, GIC_NODE);
+	else if (node >= 0) {
+		ret = check_owned_node(fdt, node);
+		if (ret)
+			return ret;
+	}
+	if (node < 0)
+		return node;
+	ret = fdt_setprop_u32(fdt, node, GIC_VERSION, GIC_VERSION_1);
+	if (!ret)
+		ret = write_ranges(fdt, node, "reg", gic->captured,
+				   gic->nr, ac, sc);
+	if (ret)
+		return ret;
+	gic->fdt_ready = true;
+	return 0;
+}
+
+int arm64_kexec_gic_validate(struct kimage *image)
+{
+	struct arm64_kexec_gic *gic = image->arch.gic_tables;
+	int nr;
+
+	if (!image->file_mode || !gic || !gic->fdt_ready)
+		return -EINVAL;
+	nr = gic_v3_kexec_snapshot(gic->scratch, KEXEC_GIC_MAX_RANGES);
+	nr = normalize_ranges(gic->scratch, nr, KEXEC_GIC_MAX_RANGES);
+	if (nr < 0)
+		return nr;
+	if (!ranges_subset(gic->scratch, nr, gic->captured, gic->nr))
+		return -ESTALE;
+	return 0;
+}
