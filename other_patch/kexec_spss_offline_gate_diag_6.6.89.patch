+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _LINUX_REMOTEPROC_KEXEC_H
+#define _LINUX_REMOTEPROC_KEXEC_H
+
+#include <linux/errno.h>
+#include <linux/kconfig.h>
+
+struct rproc;
+
+/*
+ * Seal one registered, bound, offline remoteproc for this kexec only.
+ * The caller must own a live rproc reference, have completed freeze_processes(),
+ * and hold neither the parent device lock nor rproc->lock. Requires an active
+ * normal kexec. Refuses busy locks or any in-flight core boot/recovery/add.
+ * Success retains references until reset; there is deliberately no unseal API.
+ * This blocks Linux core startup paths, not an external firmware agent.
+ */
+#if IS_ENABLED(CONFIG_REMOTEPROC_KEXEC_OFFLINE_GATE)
+int rproc_kexec_seal_offline(struct rproc *rproc);
+#else
+static inline int rproc_kexec_seal_offline(struct rproc *rproc)
+{
+	return -EOPNOTSUPP;
+}
+#endif
+
+#endif /* _LINUX_REMOTEPROC_KEXEC_H */
