+#ifdef CONFIG_ARM64_KEXEC_GIC_TABLES
+/*
+ * An ownership change announces itself before allocation or freeing, but
+ * never holds this lock across that work.  The snapshot holds the lock only
+ * for its bounded scan, and rejects an already announced change.  This also
+ * covers indirect L2 creation before its_device_list insertion, which the
+ * existing its->lock alone cannot serialize.  Lock order for the snapshot is
+ * snapshot_lock -> its_lock -> its->lock.  Mutators drop snapshot_lock before
+ * taking any of those existing locks (and before any sleeping operation).
+ */
+static DEFINE_RAW_SPINLOCK(its_kexec_snapshot_lock);
